# Local config for the security scanning kit. Copy to
# ~/.config/gatherpack-scan/config.env (or point GP_SCAN_CONFIG at another
# file), fill in your values and keep it out of git: it names your staging
# site and the commands that reach it. Every script sources it (plain
# KEY=VALUE shell syntax, $HOME expands); the Python scripts read the same
# values from the environment or parse this file.
#
# SCAN ONLY A STAGING COPY. The scans change data and the cross-role writes
# replay changes as other users; the kit restores the copy after each step.

# --- Target ---------------------------------------------------------------

# Base URL of the staging site, no trailing slash.
SCAN_BASE_URL=https://staging.example.org

# Data directory (create it with mode 700): role passwords (passwords.txt, one
# "<role> <password>" per line, mode 600), role-ids.json, the run folders and
# the ZAP homes. Everything in it can hold real data: never commit it.
SCAN_DATA=$HOME/gatherpack-scan-data

# Scan roles, space separated. The Rails scripts create these five logins.
#SCAN_ROLES="student parent mentor student2 architect"

# printf pattern for a role's sign-in email.
#SCAN_EMAIL_PATTERN=zap.%s@example.invalid

# --- Commands that reach the staging server -------------------------------
# The kit knows nothing about how the server is reached; each command is run
# with bash, stdin closed, and must exit non-zero on failure.

# Takes a backup of the staging copy (databases and storage) and prints its
# stamp on the last line of stdout. Progress output goes to stderr.
SCAN_BASELINE_CMD="$HOME/gatherpack-scan-data/local/backup.sh"

# Restores the backup; the stamp is appended as the last argument. Must exit
# non-zero unless the restored app is serving again.
SCAN_RESTORE_CMD="$HOME/gatherpack-scan-data/local/restore.sh"

# Prints the app's web log since an ISO time (appended as the last argument).
SCAN_APP_LOGS_CMD="$HOME/gatherpack-scan-data/local/app-logs.sh"

# Runs a Ruby file with `bin/rails runner` inside the staging app. Called as
#   <cmd> [KEY=VALUE | KEY ...] /path/to/file.rb
# Each KEY=VALUE, and each bare KEY (value taken from the caller's environment,
# used for passwords so they stay out of `ps`), must reach the script as ENV, and the command must set
# SCAN_ALLOW_PRODUCTION_ENV=1 there (staging copies run the production Rails
# environment, which the Rails scripts refuse otherwise).
SCAN_RAILS_RUNNER_CMD="$HOME/gatherpack-scan-data/local/rails-runner.sh"

# --- Code checks -----------------------------------------------------------

# Checkout that Brakeman, importmap audit and bundler-audit run in
# (campaign.sh --code-only needs only this and SCAN_DATA).
SCAN_CODE_DIR=$HOME/src/gatherpack

# --- ZAP -------------------------------------------------------------------

ZAP_SH=$HOME/.local/bin/zap.sh
# ZAP home for the deep and public plans (updated add-ons).
ZAP_HOME_DEEP=$SCAN_DATA/home-v2
# ZAP home for the first-pass quick/full plan.
ZAP_HOME_FULL=$SCAN_DATA/home

# --- Only for setup-accounts.sh (creating the scan logins) -----------------

# Names of existing teams on the staging copy.
#   MEMBER:    the student's team, which the mentor manages
#   GUARDIANS: the parent's team
#   MENTORS:   the mentor's and architect's team
#   PEER:      the second student's team, outside the mentor's management
SCAN_TEAM_MEMBER="Team A"
SCAN_TEAM_GUARDIANS="Team B"
SCAN_TEAM_MENTORS="Team C"
SCAN_TEAM_PEER="Team D"
# Email of an existing admin login on the staging copy; the new
# relationship is recorded as created by that person.
SCAN_ADMIN_EMAIL=admin@example.invalid
