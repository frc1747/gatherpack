<% seconds = TimeKiosk::Config.return_seconds %>
<% if seconds.positive? %>
  <div class="position-fixed bottom-0 end-0 m-3 small text-body-secondary" id="kiosk-return-timer"
       data-controller="kiosk-return" data-kiosk-return-seconds-value="<%= seconds %>" data-kiosk-return-url-value="<%= time_kiosk_path %>">
    Returning in <span data-kiosk-return-target="count"><%= seconds %></span>s
  </div>
<% end %>
