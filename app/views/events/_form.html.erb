<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

<div class="row">
  <div class="col-6">
    <%= f.input :name %>
    <%= f.input :description %>
    <div data-controller="event-time">
      <%= f.input :time_kind, as: :radio_buttons, label: "Time", include_blank: false,
            collection: [ [ "At a set time", "timed" ], [ "All day", "all_day" ], [ "Time to be announced", "tba" ] ],
            input_html: { data: { action: "event-time#sync", event_time_target: "kind" } } %>
      <%= f.input :event_date, as: :string, label: "Date", required: false, hint: "For all day or time to be announced.",
            input_html: { type: "date", data: { event_time_target: "date" } }, wrapper_html: { data: { event_time_target: "dateField" } } %>
      <%= f.input :start_time, input_html: { data: { action: "event-time#copyStartDate", event_time_target: "start" } }, wrapper_html: { data: { event_time_target: "timeField" } } %>
      <%= f.input :end_time, input_html: { value: (f.object.timed? ? f.object.end_time : ""), data: { event_time_target: "end" } }, wrapper_html: { data: { event_time_target: "timeField" } } %>
    </div>
    <%= f.input :location %>
    <%= f.input :locked %>
  </div>
  <div class="col-6">
    <div class="row">
      <div class="col">
        <%= f.association :event_type %>
      </div>
      <div class="col">
        <%= f.input :time_clock_period_id, as: :searching_combobox, label: "Time Clock Period", scope: "time_clock_periods", include_blank: true %>
      </div>
    </div>
    <div class="row">
      <div class="col">
        <%= f.input :team_id, as: :searching_combobox, label: "Team", scope: "managed_teams", include_blank: admin? %>
      </div>
    </div>
    <div class="row">
      <div class="col">
        <%= f.input :checkin_limit %>
      </div>
    </div>
  </div>
</div>
