<% breadcrumb :signup_sheets %>

<div class="card">
  <div class="card-header">
    <h1>Sign-up Sheets</h1>
  </div>
  <div class="card-body">
    <% if @signup_sheets.any? %>
      <table class="table">
        <thead>
          <tr>
            <th>Sheet</th>
            <th>Team</th>
            <th>Next date</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "sheet_row", collection: @signup_sheets, as: :signup_sheet %>
        </tbody>
      </table>
    <% else %>
      <p>No sign-up sheets for you right now.</p>
    <% end %>
  </div>
  <% if policy(SignupSheet).new? %>
    <div class="card-footer">
      <%= link_to "New Sign-up Sheet", new_signup_sheet_path, class: "btn btn-success" %>
    </div>
  <% end %>
</div>
