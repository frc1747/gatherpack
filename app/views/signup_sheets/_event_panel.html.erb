<%# The Sign-up sheets panel on an event page: one row per sheet at the event
    the viewer may see, with its state in words, its positions, how full they
    are, names to people allowed to see them, and one button: Sign up for
    members, Open for organizers. People who can make sheets for the event's
    team get a New link, and the empty line when there are none. Rendered
    from events/show. %>
<% viewer = current_user&.person %>
<% if GatherPack::Features.enabled?(:signups) && viewer %>
  <% sheets = event.signup_sheets.visible.includes(:team).order(:title).select { |sheet| policy(sheet).show? } %>
  <% can_add = event.team_id.present? && SignupSheet.creatable_team_ids(viewer).include?(event.team_id) %>
  <% if sheets.any? || can_add %>
    <div class="card mt-3" id="event_signups">
      <div class="card-header">
        <h2 class="h5 mb-0">Sign-up sheets</h2>
      </div>
      <% if sheets.any? %>
        <div class="list-group list-group-flush">
          <% sheets.each do |sheet| %>
            <% names_visible = sheet.names_visible_to?(viewer) %>
            <% slots = sheet.signup_slots.where(event_id: event.id, disabled: false).includes(:signup_position, signups: :person)
                 .sort_by { |slot| [ slot.signup_position.position, slot.signup_position.created_at ] } %>
            <% sheet_path = signup_sheet_path(sheet, anchor: dom_id(event)) %>
            <div class="list-group-item" id="<%= dom_id sheet, :event_panel %>">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>
                  <%= link_to sheet.title, sheet_path %><br>
                  <small class="text-muted"><%= signup_sheet_state(sheet) %></small>
                </span>
                <% if sheet.organizer?(viewer) %>
                  <%= link_to "Open", sheet_path, class: "btn btn-sm btn-outline-secondary" %>
                <% elsif sheet.open? %>
                  <%= link_to "Sign up", sheet_path, class: "btn btn-sm btn-primary" %>
                <% end %>
              </div>
              <% if slots.any? %>
                <ul class="list-unstyled mb-0 mt-1">
                  <% slots.each do |slot| %>
                    <% position = slot.signup_position %>
                    <% counted = slot.signups.select { |signup| signup.active? || signup.fulfilled? } %>
                    <% used = counted.sum(&:usage) %>
                    <% cap = slot.capacity_value %>
                    <li id="<%= dom_id slot, :event_panel %>">
                      <strong><%= position.name %></strong>
                      <span class="text-body-secondary">
                        <% if position.items? %>
                          <%= cap ? "#{used} of #{cap} #{position.unit_label}" : "#{used} #{position.unit_label}, no limit" %>
                        <% else %>
                          <%= cap ? "#{used} of #{cap} filled" : "#{used} signed up, no limit" %>
                        <% end %>
                      </span>
                      <% if names_visible && counted.any? %>
                        <span class="small">: <%= counted.map { |signup| signup.person.identifier_name }.join(", ") %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-body-secondary mb-0 mt-1">Nothing needed at this event yet.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="card-body">
          <%= render "shared/empty_state", text: "No sign-up sheets for this event." %>
        </div>
      <% end %>
      <% if can_add %>
        <div class="card-footer">
          <%= link_to "New sign-up sheet for this event", new_signup_sheet_path(event_id: event.id), class: "btn btn-sm btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
