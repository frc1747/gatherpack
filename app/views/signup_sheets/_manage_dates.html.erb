<% sheet_events = @signup_sheet.signup_sheet_events.includes(:event).sort_by { |sheet_event| sheet_event.event.start_time } %>
<div class="card mb-3" id="dates">
  <div class="card-header">
    <h3 class="h5 mb-0">Dates</h3>
  </div>
  <div class="card-body">
    <p>The events people sign up for. Pick existing events here; for now, make new ones on the <%= link_to "Events", events_path %> page first.</p>
    <% if sheet_events.any? %>
      <ul class="list-group mb-3">
        <% sheet_events.each do |sheet_event| %>
          <li class="list-group-item d-flex justify-content-between align-items-center" id="<%= dom_id sheet_event %>">
            <span>
              <%= sheet_event.event.start_time.strftime("%a %b %-d, %Y %-l:%M %p") %>
              <strong><%= sheet_event.event.name %></strong><%= ", #{sheet_event.event.location}" if sheet_event.event.location.present? %>
            </span>
            <%= button_to "Remove", signup_sheet_signup_sheet_event_path(@signup_sheet, sheet_event), method: :delete,
                  class: "btn btn-sm btn-outline-danger", form_class: "d-inline",
                  data: { turbo_confirm: "Remove #{sheet_event.event.name} from the sheet? The event itself stays." } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-warning-emphasis">No dates yet.</p>
    <% end %>
    <%= link_to "Add dates", new_signup_sheet_signup_sheet_event_path(@signup_sheet), class: "btn btn-success" %>
  </div>
</div>
