<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
<%= f.hidden_field :kind %>

<div class="form-inputs">
  <%= f.input :subject_id, as: :select, label: @source.kind_class.subject_type.titleize, collection: @subject_choices,
        label_method: ->(subject) { subject.try(:identifier_name) || subject.try(:name) }, value_method: :id, include_blank: false,
        error: f.object.errors[:subject].first %>
  <div class="row">
    <div class="col-6 col-md-3">
      <%= f.input :per, label: "Every", hint: "records", input_html: { min: 1 } %>
    </div>
    <div class="col-6 col-md-3">
      <%= f.input :credits, label: "Earn", hint: @commitment.unit, input_html: { min: 1 } %>
    </div>
    <div class="col-6 col-md-3">
      <%= f.input :max_credits, label: "At most", hint: "#{@commitment.unit} per person from this source. Blank for no limit.", input_html: { min: 1 } %>
    </div>
    <div class="col-6 col-md-3">
      <%= f.input :position, label: "Order", hint: "Lower counts first." %>
    </div>
  </div>
</div>
