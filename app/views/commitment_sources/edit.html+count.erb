<%# Changing what counts toward a count item (CountItemCommitmentPages). %>
<% breadcrumb :checklist_count_part, count_item, @source.label %>

<%= simple_form_for([ @commitment, @source ]) do |f| %>
<div class="card">
  <div class="card-header">
    <h1>Editing <%= @source.label %></h1>
  </div>
  <div class="card-body">
    <%= render "form", f: f %>
  </div>
  <div class="card-footer">
    <%= link_to "Cancel", edit_checklist_checklist_item_path(count_item.checklist, count_item, anchor: "sources"), class: "btn btn-warning" %>
    <%= f.button :submit, "Save", class: "btn btn-primary" %>
  </div>
</div>
<% end %>
