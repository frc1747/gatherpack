<div class="card" id="<%= dom_id badge %>">
  <div class="card-header">
    <%= as_badge badge, data: { turbo_frame: "_top" } %>&nbsp;
    <%= link_to badge.identifier_name, badge, data: { turbo_frame: "_top" } %>
  </div>
  <div class="card-body">
    <%= pluralize policy_scope(badge.people).count, "person" %>
  </div>
</div>
