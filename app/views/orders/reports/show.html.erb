<% breadcrumb :orders_report, @report %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= @report.title %></h1>
  <%= button_tag "Print", type: "button", class: "btn btn-dark no-print", data: { controller: "print", action: "print#print" } %>
</div>
<p class="text-muted"><%= @report.description %>. As of <%= l Date.current, format: :long %>.</p>
<div class="no-print">
  <%= render "shared/filter_bar", url: orders_report_path(@report.key),
        table_actions: [ screen_action("Download CSV", orders_report_path(@report.key, format: :csv)) ] %>
</div>

<% @report.tables.each do |table| %>
  <div class="card mb-3">
    <div class="card-header"><h2 class="h5 mb-0"><%= table.title %></h2></div>
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead>
          <tr><% table.headers.each do |header| %><th><%= header %></th><% end %></tr>
        </thead>
        <tbody>
          <% table.rows.each do |row| %>
            <tr>
              <% row.each do |value| %>
                <td><%= value.is_a?(Money) ? value.format : (value.is_a?(Date) ? l(value, format: :short) : value) %></td>
              <% end %>
            </tr>
          <% end %>
          <% if table.rows.empty? %>
            <tr><td colspan="<%= table.headers.size %>" class="text-muted">Nothing to show.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
