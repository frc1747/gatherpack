<% breadcrumb :orders_reports %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h1>Reports</h1>
  </div>
  <div class="list-group list-group-flush">
    <% @keys.each do |key| %>
      <%= link_to orders_report_path(key), class: "list-group-item list-group-item-action" do %>
        <strong><%= Orders::Reports::TITLES[key] %></strong><br>
        <small class="text-muted"><%= Orders::Reports::DESCRIPTIONS[key] %></small>
      <% end %>
    <% end %>
  </div>
</div>
