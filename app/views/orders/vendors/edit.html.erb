<% breadcrumb :orders_vendors %>

<%= simple_form_for(@vendor, url: @vendor.persisted? ? orders_vendor_path(@vendor) : orders_vendors_path) do |f| %>
  <div class="card">
    <div class="card-header">
      <h1>Edit vendor</h1>
    </div>
    <div class="card-body">
      <%= render "form", f: f %>
    </div>
    <div class="card-footer">
      <%= link_to "Cancel", orders_vendors_path, class: "btn btn-secondary" %>
      <%= f.button :submit, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>

<%= render "pattern_test", vendor: @vendor %>
