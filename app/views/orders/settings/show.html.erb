<% breadcrumb :orders_settings %>

<%= form_with url: orders_settings_path, method: :patch do |f| %>
  <div class="card">
    <div class="card-header"><h1>Orders setup</h1></div>
    <div class="card-body">
      <% if @editor.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0"><% @editor.errors.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>

      <section class="mb-4">
        <h2 class="h5">Who can ask</h2>
        <%= render "orders/settings/field", f: f, editor: @editor, name: :requesters %>
      </section>

      <section class="mb-4">
        <h2 class="h5">Who sees every request</h2>
        <%= render "orders/settings/field", f: f, editor: @editor, name: :viewers %>
      </section>

      <section class="mb-4" id="orders_lists">
        <h2 class="h5">Lists</h2>
        <p class="form-text">Each has a screen of its own, also on the Setup page under <%= Orders::SETUP_SECTION %>.</p>
        <div class="list-group">
          <%= link_to orders_approval_steps_path, class: "list-group-item list-group-item-action" do %>
            <strong>Approval steps</strong>
            <div class="small text-muted">Who approves, and from which total.</div>
          <% end %>
          <%= link_to managed_list_path(:payment_methods), class: "list-group-item list-group-item-action" do %>
            <strong>Payment methods</strong>
            <div class="small text-muted">How a purchase can be paid, and which need paying back.</div>
          <% end %>
          <%= link_to managed_list_path(:delivery_problem_kinds), class: "list-group-item list-group-item-action" do %>
            <strong>Delivery problems</strong>
            <div class="small text-muted">What can be wrong with something that arrives.</div>
          <% end %>
        </div>
      </section>

      <section class="mb-4">
        <h2 class="h5">Who buys</h2>
        <%= render "orders/settings/field", f: f, editor: @editor, name: :buyers %>
      </section>

      <section class="mb-4">
        <h2 class="h5">Who manages funding sources</h2>
        <%= render "orders/settings/field", f: f, editor: @editor, name: :funding_managers %>
      </section>

      <% Orders::SettingsEditor.sections.each do |heading, settings| %>
        <section class="mb-4">
          <h2 class="h5"><%= heading %></h2>
          <% settings.each do |setting| %>
            <%= render "orders/settings/value", setting: setting, value: @editor.values.fetch(setting.setting_key) %>
          <% end %>
        </section>
      <% end %>
    </div>
    <div class="card-footer">
      <%= f.submit "Save", class: "btn btn-lg btn-success" %>
      <%= link_to "Cancel", orders_requests_path, class: "btn btn-lg btn-primary" %>
    </div>
  </div>
<% end %>
