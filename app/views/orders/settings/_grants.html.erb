<%# Badge grant rows for an orders reach (Orders::Reach), drawn like the
    settings pickers' badge grants and posting the same fields, with the
    orders words: a badge works for the team picked and the teams below it,
    or for every team. %>
<% badge_names = input.badges.map(&:name) %>
<% teams = input.teams %>
<fieldset data-controller="setting-rows">
  <legend class="form-label fs-6"><%= input.setting.name %></legend>
  <div class="form-text mb-2">Each badge works up to the team picked, and the teams below it. No team: every team.</div>
  <div data-setting-rows-target="list">
    <% input.rows.each_with_index do |row, index| %>
      <%= render "orders/settings/grant_row", input: input, index: index, row: row, badge_names: badge_names, teams: teams %>
    <% end %>
    <%= render "orders/settings/grant_row", input: input, index: input.rows.size, row: nil, badge_names: badge_names, teams: teams %>
  </div>
  <template data-setting-rows-target="template">
    <%= render "orders/settings/grant_row", input: input, index: "NEW_ROW", row: nil, badge_names: badge_names, teams: teams %>
  </template>
  <button type="button" class="btn btn-secondary" style="min-height: 44px" hidden data-setting-rows-target="add" data-action="setting-rows#add">Add a badge</button>
</fieldset>
