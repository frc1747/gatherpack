<%# One of Orders::SettingsEditor::FIELDS: the settings picker where there is one, else a text box with one entry per line. %>
<% if Orders::SettingsEditor.pickers? %>
  <% input = editor.picker(name) %>
  <%= render partial: input.to_partial_path, locals: { f: f, setting: input.setting, input: input } %>
<% else %>
  <%= label_tag "settings_#{name}", Orders::SettingsEditor::FIELDS.fetch(name), class: "form-label" %>
  <%= text_area_tag "settings[#{name}]", editor.text(name), id: "settings_#{name}", class: "form-control", rows: 3 %>
  <div class="form-text"><%= Orders::SettingsEditor::TEAM_FIELDS.include?(name) ? "One team name per line." : "One per line, as Badge name > Highest team name." %></div>
<% end %>
