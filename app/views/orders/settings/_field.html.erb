<%# One of Orders::SettingsEditor::FIELDS: grant rows for a role, else the settings picker where there is one, else a text box with one entry per line. %>
<% if Orders::SettingsEditor::GRANT_FIELDS.include?(name) %>
  <%= render "orders/settings/grant_rows", name: name, rows: editor.picker(name) %>
<% elsif Orders::SettingsEditor.pickers? %>
  <% input = editor.picker(name) %>
  <%= render partial: input.to_partial_path, locals: { f: f, setting: input.setting, input: input } %>
<% else %>
  <%= label_tag "settings_#{name}", Orders::SettingsEditor::FIELDS.fetch(name), class: "form-label" %>
  <%= text_area_tag "settings[#{name}]", editor.text(name), id: "settings_#{name}", class: "form-control", rows: 3 %>
  <div class="form-text"><%= name == :requesters ? "One team name per line. Or a row as for who buys: Badge name > Team name, Managers of Team name > Team name, or Managers of each team." : "One team name per line." %></div>
<% end %>
