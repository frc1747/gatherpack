<% breadcrumb :orders_edit_purchase, @purchase %>

<div class="card">
  <div class="card-header">
    <h1>Edit order</h1>
    <div><%= @purchase.vendor_name %></div>
  </div>
  <div class="card-body">
    <%= simple_form_for @purchase, url: orders_purchase_path(@purchase), html: { multipart: true, data: { turbo: false } } do |f| %>
      <%= f.error_notification %>
      <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>
      <%= render "orders/purchases/fields", f: f %>
      <div class="d-flex gap-2">
        <%= f.button :submit, "Save", class: "btn btn-primary" %>
        <%= link_to "Cancel", orders_purchase_path(@purchase), class: "btn btn-warning" %>
      </div>
    <% end %>
  </div>
</div>
