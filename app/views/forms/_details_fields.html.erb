<% form = f.object %>
<div class="row">
  <div class="col-md-8"><%= f.input :title %></div>
  <div class="col-md-4">
    <% if form.persisted? %>
      <%= f.input :key, disabled: true, hint: "Used by Hooks and Pages; can't be changed." %>
    <% else %>
      <%= f.input :key, required: false, hint: "Used by Hooks and Pages. Leave blank to generate it from the title." %>
    <% end %>
  </div>
</div>

<%= f.input :description, as: :text, input_html: { rows: 4 }, hint: "Shown at the top of the form. Markdown is supported." %>

<% if GatherPack::Features.enabled?(:events) %>
  <% owning = form.persisted? ? [ form.team ] : policy(form).assignable_teams.to_a %>
  <% team_ids = owning.flat_map { |team| [ team.id ] + team.all_descendant_ids + team.all_ancestor_ids }.uniq %>
  <% events = Event.where(team_id: team_ids).where("start_time >= ?", 1.month.ago).order(:start_time).to_a %>
  <% events.unshift(form.event) if form.event && !events.include?(form.event) %>
  <%# Form creators (the creator badge) only make event forms. %>
  <% creator_only = form.persisted? ? policy(form).creator_only? : !(current_user.admin? || current_user.person.all_managed_teams.exists?) %>
  <%= f.input :event_id, label: "Event", collection: events.map { |event| [ event.to_combobox_display, event.id ] }, include_blank: (creator_only ? false : "None: not for a particular event"),
        hint: "For a trip permission slip or a \"coming Saturday?\" form. The event page shows this form, and the deadline defaults to the event's start. Events of the owning team or a team above or below it. A form for an event of a team above asks only the owning team.#{" A new event form asks the event's team." unless form.persisted?}" %>
<% end %>

<%= f.input :team_id, label: "Owning team", collection: policy(form).assignable_teams.order(:name), include_blank: false,
      hint: form.persisted? ? "Its managers, and those of teams above it, manage this form. Who is asked is on its own tab." : "Its managers, and those of teams above it, manage this form. The form starts by asking everyone in it; you can change who is asked next." %>
