<div class="card" id="questions">
  <div class="card-body">
    <% if @form.form_questions.empty? %>
      <p class="text-muted">No questions yet.</p>
    <% else %>
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead>
            <tr>
              <th>Question</th>
              <th>Type</th>
              <th>Profile</th>
              <th>Required</th>
              <th>Who can see / answer</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @form.form_questions.includes(:person_field).each do |question| %>
              <tr id="<%= dom_id question %>">
                <td>
                  <%= link_to (question.label.presence || question.body.to_s.truncate(60)), edit_form_question_path(@form, question) %><br>
                  <small class="text-muted"><%= question.key %></small>
                </td>
                <td>
                  <% if question.input? %>
                    <%= question.profile_backed? ? question.person_field.name : person_field_type_label(question) %>
                  <% elsif question.signature? %>
                    Signature<br><small class="text-muted"><%= FormsHelper::SIGNER_LABELS.fetch(question.signer) %></small>
                  <% else %>
                    <%= question.kind.humanize %>
                  <% end %>
                </td>
                <td><%= question.input? ? FormsHelper::PROFILE_MODE_LABELS.fetch(question.profile_mode) : "—" %></td>
                <td><%= (question.answerable? || question.signature?) && question.required? ? "✓" : "—" %></td>
                <td>
                  <% if question.answerable? %>
                    <% if question.read_permission || question.write_permission %>
                      <small>See: <%= form_level_label(question.effective_read_permission) %><br>Answer: <%= form_level_label(question.effective_write_permission) %></small>
                    <% else %>
                      <small class="text-muted">As the form</small>
                    <% end %>
                  <% end %>
                </td>
                <td class="text-nowrap">
                  <%= button_to i("arrow-up"), move_form_question_path(@form, question, direction: "up"), method: :patch, class: "btn btn-sm btn-light", form_class: "d-inline", title: "Move up" %>
                  <%= button_to i("arrow-down"), move_form_question_path(@form, question, direction: "down"), method: :patch, class: "btn btn-sm btn-light", form_class: "d-inline", title: "Move down" %>
                  <%= button_to "Remove", form_question_path(@form, question), method: :delete, class: "btn btn-sm btn-danger", form_class: "d-inline",
                        data: { turbo_confirm: "Remove this question? Answers already given stay in earlier submissions." } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
  <div class="card-footer">
    <%= link_to "Add a question", new_form_question_path(@form, kind: "input"), class: "btn btn-primary" %>
    <%= link_to "Add a heading", new_form_question_path(@form, kind: "heading"), class: "btn btn-secondary" %>
    <%= link_to "Add text", new_form_question_path(@form, kind: "statement"), class: "btn btn-secondary" %>
    <%= link_to "Add an acknowledgment", new_form_question_path(@form, kind: "acknowledgment"), class: "btn btn-secondary" %>
    <%= link_to "Add a signature", new_form_question_path(@form, kind: "signature"), class: "btn btn-secondary" %>
  </div>
</div>
