<%# A record's action row: the actions with in_row: true as buttons (the first stays on
    phones, the rest fold into More there), then More holding everything else: lifecycle
    actions, then destructive ones, last. Shaped like the planned shared/_action_row; each action is a Hash with
    label:, path:, style: (:warning, :primary, :secondary…), method: (:get default),
    confirm:, in_row:, lifecycle: (Archive, Restore: after the others), destructive: (Delete: last, red). %>
<% row, menu = actions.partition { |action| action[:in_row] } %>
<% menu = menu.sort_by.with_index { |action, index| [ (action[:destructive] ? 2 : (action[:lifecycle] ? 1 : 0)), index ] } %>
<% phone_menu = row.drop(1) %>
<% item = lambda do |action, classes|
     data = action[:confirm] ? { turbo_confirm: action[:confirm] } : {}
     if (action[:method] || :get) == :get
       link_to action[:label], action[:path], class: classes
     else
       button_to action[:label], action[:path], method: action[:method], class: classes, form_class: (classes.include?("dropdown-item") ? nil : "d-inline"), data: data
     end
   end %>
<div class="d-flex flex-wrap gap-2 no-print" id="actions">
  <% row.each_with_index do |action, index| %>
    <%= item.call(action, [ "btn btn-#{action[:style] || :secondary}", ("d-none d-md-inline-block" if index.positive?) ].compact.join(" ")) %>
  <% end %>
  <% if menu.any? || phone_menu.any? %>
    <div class="dropdown">
      <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">More</button>
      <ul class="dropdown-menu">
        <% phone_menu.each do |action| %>
          <li class="d-md-none"><%= item.call(action, "dropdown-item") %></li>
        <% end %>
        <% menu.each do |action| %>
          <li><%= item.call(action, [ "dropdown-item", ("text-danger" if action[:destructive]) ].compact.join(" ")) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
