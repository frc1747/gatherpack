<% breadcrumb :form_order_sheet %>
<% sheet = @sheet %>

<div class="card no-print">
  <div class="card-header">
    <h1>Order Sheet</h1>
    <div class="text-muted">One form's answers for an event's people: what to order, and for whom. Intent is a planning count; only check-ins count as attending.</div>
  </div>
  <div class="card-body">
    <%= form_with url: order_sheet_forms_path, method: :get do %>
      <div class="row g-2">
        <div class="col-md-4">
          <%= label_tag :event_id, "Event", class: "form-label" %>
          <%= select_tag :event_id, options_for_select(@events.map { |event| [ event.to_combobox_display, event.id ] }, @event&.id), include_blank: "No event: everyone the form asks", class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= label_tag :form_id, "Answers from", class: "form-label" %>
          <%= select_tag :form_id, options_for_select(@forms.map { |form| [ form.title, form.id ] }, @form&.id), include_blank: "Choose a form…", class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= label_tag :basis, "People", class: "form-label" %>
          <%= select_tag :basis, options_for_select(FormsHelper::BASIS_LABELS.invert.except("Everyone asked").to_a + [ [ "Everyone the form asks", "asked" ] ], sheet&.basis || params[:basis]), class: "form-select" %>
        </div>
        <% if @form %>
          <div class="col-md-6">
            <%= label_tag "question_ids[]", "Questions to show", class: "form-label" %>
            <%= select_tag "question_ids[]", options_for_select(@choices.map { |question| [ question.label, question.id ] }, sheet.questions.map(&:id)), multiple: true, class: "form-select", size: [ @choices.size, 6 ].min %>
          </div>
          <div class="col-md-4">
            <%= label_tag "field_ids[]", "Profile details alongside", class: "form-label" %>
            <%= select_tag "field_ids[]", options_for_select(@profile_fields.map { |field| [ field.name, field.id ] }, sheet.fields.map(&:id)), multiple: true, class: "form-select", size: [ [ @profile_fields.size, 1 ].max, 6 ].min %>
          </div>
          <div class="col-md-2">
            <%= label_tag :layout, "Layout", class: "form-label" %>
            <%= select_tag :layout, options_for_select([ [ "List", "list" ], [ "Bag labels", "labels" ] ], @layout), class: "form-select" %>
          </div>
        <% end %>
      </div>
      <div class="mt-3">
        <%= submit_tag "Show", class: "btn btn-primary", name: nil %>
        <% if sheet %><button type="button" class="btn btn-secondary" onclick="window.print()">Print</button><% end %>
      </div>
    <% end %>
  </div>
</div>

<% if sheet %>
  <div class="card mt-3">
    <div class="card-header">
      <h2><%= @form.title %><%= ": #{@event.name}" if @event %></h2>
      <div class="text-muted">
        <%= { "expected" => "People who said they're coming", "checked_in" => "People who checked in", "asked" => "Everyone the form asks" }.fetch(sheet.basis) %>:
        <%= sheet.population.size %> · <%= pluralize(sheet.listed.size, "choice") %> on file
        <% if @event %> · <%= nice_datetime(@event.start_time) %><% end %>
      </div>
    </div>
    <div class="card-body">
      <% unless sheet.basis_available? %>
        <div class="alert alert-warning no-print">No form on <%= @event.name %> asks who's coming, so nobody counts as expected. Add an "Are you coming?" question to a form for this event, or base the sheet on check-ins.</div>
      <% end %>

      <% if sheet.questions.empty? && sheet.fields.empty? %>
        <p class="text-muted">Choose the questions to show.</p>
      <% elsif @layout == "labels" %>
        <div class="row g-2">
          <% sheet.listed.each do |line| %>
            <div class="col-6 col-lg-4">
              <div class="border rounded p-2 h-100" style="page-break-inside: avoid;">
                <div class="fw-bold"><%= line.person.identifier_name %></div>
                <% sheet.questions.each do |question| %>
                  <% value = sheet.answer(line, question) %>
                  <% next if value.blank? %>
                  <div><small class="text-muted"><%= question.label %>:</small> <%= form_csv_value(value) %></div>
                <% end %>
                <% sheet.fields.each do |field| %>
                  <% value = sheet.profile(line, field) %>
                  <% next if value.blank? %>
                  <div><small class="text-muted"><%= field.name %>:</small> <%= form_csv_value(value) %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-sm table-striped align-middle">
            <thead>
              <tr>
                <th>Person</th>
                <% sheet.questions.each do |question| %><th><%= question.label %></th><% end %>
                <% sheet.fields.each do |field| %><th class="table-info"><%= field.name %></th><% end %>
              </tr>
            </thead>
            <tbody>
              <% sheet.listed.each do |line| %>
                <tr id="<%= dom_id line.person %>">
                  <td><%= line.person.identifier_name %></td>
                  <% sheet.questions.each do |question| %>
                    <td><%= sheet.report.readable?(line.row, question) ? form_csv_value(sheet.answer(line, question)) : "·" %></td>
                  <% end %>
                  <% sheet.fields.each do |field| %>
                    <td class="table-info"><%= sheet.profile_readable?(line, field) ? form_csv_value(sheet.profile(line, field)) : "·" %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <% if sheet.no_choice.any? %>
        <h3 class="h6 mt-3">No choice on file: <%= sheet.no_choice.size %></h3>
        <ul class="mb-2">
          <% sheet.no_choice.each do |line| %>
            <li>
              <%= line.person.identifier_name %>
              <% details = sheet.fields.filter_map { |field| (value = sheet.profile(line, field)).present? ? "#{field.name}: #{form_csv_value(value)}" : nil } %>
              <% if details.any? %><small class="text-muted">(<%= details.join("; ") %>)</small><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if sheet.hidden.any? %>
        <p class="text-muted mt-2">Not shown: <%= pluralize(sheet.hidden.size, "person", plural: "people") %> whose answers you can't see.</p>
      <% end %>

      <% if sheet.questions.any? && sheet.listed.any? %>
        <h3 class="h5 mt-4">Totals</h3>
        <div class="row">
          <% sheet.questions.select { |question| form_tallyable?(question) }.each do |question| %>
            <div class="col-12 col-md-6 col-xl-4 mb-3" style="page-break-inside: avoid;">
              <h4 class="h6"><%= question.label %></h4>
              <table class="table table-sm">
                <tbody>
                  <% sheet.tally(question).each do |value, count| %>
                    <% next if count.zero? %>
                    <tr class="<%= "text-muted" if value.nil? %>"><td><%= form_tally_label(value) %></td><td class="text-end"><%= count %></td></tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
