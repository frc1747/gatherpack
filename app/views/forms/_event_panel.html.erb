<%# The Forms panel on an event page: forms attached to the event, how
    many have answered, and, where a form asks "Are you coming?", how that
    intent compares with check-ins. Intent is never attendance. %>
<% if GatherPack::Features.enabled?(:forms) %>
  <% event_forms = EventForms.new(event, viewer: current_user.person) %>
  <% can_add = event.team && policy(Form.new(team: event.team, event: event)).create? %>
  <% if event_forms.forms.empty? && can_add %>
    <div class="card mt-3 no-print" id="event-forms">
      <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted">No forms for this event yet: a permission slip, or "Are you coming?" for planning.</span>
        <%= link_to "New form for this event", new_form_path(event_id: event.id), class: "btn btn-sm btn-secondary" %>
      </div>
    </div>
  <% elsif event_forms.forms.any? %>
    <% viewer = current_user.person %>
    <% subjects = [ viewer ] + viewer.wards.order(:first_name).to_a %>
    <% managed = event_forms.forms.select { |form| policy(form).show? } %>
    <div class="card mt-3" id="event-forms">
      <div class="card-header"><h2>Forms</h2></div>
      <div class="card-body">
        <div class="list-group mb-3">
          <% event_forms.forms.each do |form| %>
            <% if managed.include?(form) %>
              <% counts = FormReport.new(form, viewer: viewer).status_counts %>
              <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>
                  <%= link_to form.title, form_path(form) %> <%= form_state_badge(form) %><br>
                  <small class="text-muted">
                    <%= counts.reject { |status, count| count.zero? || status == "no_longer_asked" }.map { |status, count| "#{FormsHelper::STATUS_LABELS.fetch(status)}: #{count}" }.join(" · ") %>
                  </small>
                </span>
                <span>
                  <%= link_to "Results", results_form_path(form), class: "btn btn-sm btn-outline-primary" %>
                  <%= link_to "Tally", tally_form_path(form), class: "btn btn-sm btn-outline-primary" %>
                </span>
              </div>
            <% else %>
              <% subjects.each do |subject| %>
                <% response = form.response_for(subject) %>
                <% access = FormAccess.new(viewer, subject, form, has_response: response.present?) %>
                <% next unless access.can_read? && (access.in_audience? || response) %>
                <% entry = FormsHelper::Entry.new(form: form, subject: subject, response: response, access: access) %>
                <%= link_to form_entry_path(entry), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
                  <span><strong><%= form.title %></strong><% unless subject == viewer %> for <%= subject.identifier_name %><% end %><br><small class="text-muted"><%= form_due(form) %></small></span>
                  <%= entry.needs_viewer_signature? ? tag.span("Needs your signature", class: "badge text-bg-primary") : form_status_badge(entry.status) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <% if event_forms.intent_form && managed.include?(event_forms.intent_form) %>
          <% counts = event_forms.intent_counts %>
          <h3 class="h6">Who said they're coming <small class="text-muted">(a planning count, not attendance)</small></h3>
          <p class="mb-2">
            Expected: <strong><%= counts["Yes"] %> yes</strong>, <%= counts["Maybe"] %> maybe, <%= counts["No"] %> no, <%= counts[nil] %> no answer
            <% if event_forms.checked_in_count.positive? %>
              · Checked in: <strong><%= event_forms.checked_in_count %></strong>
            <% end %>
          </p>
          <% if event_forms.checked_in_count.positive? %>
            <div class="row">
              <div class="col-md-6">
                <% missing = event_forms.yes_not_checked_in %>
                <h4 class="h6">Said yes, not checked in (<%= missing.size %>)</h4>
                <p class="small"><%= missing.map(&:identifier_name).sort.join(", ").presence || "Nobody." %></p>
              </div>
              <div class="col-md-6">
                <% surprise = event_forms.checked_in_without_yes %>
                <h4 class="h6">Checked in without saying yes (<%= surprise.size %>)</h4>
                <p class="small"><%= surprise.map(&:identifier_name).sort.join(", ").presence || "Nobody." %></p>
              </div>
            </div>
          <% end %>
        <% end %>

        <% if managed.any? %>
          <%= link_to "Printable list for this event", print_list_forms_path(event_id: event.id), class: "btn btn-sm btn-secondary" %>
        <% end %>
        <% if can_add %>
          <%= link_to "New form for this event", new_form_path(event_id: event.id), class: "btn btn-sm btn-outline-secondary" %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
