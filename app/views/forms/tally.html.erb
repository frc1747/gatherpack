<% breadcrumb :form_tally, @form %>

<div class="card">
  <div class="card-header">
    <h1><%= @form.title %>: Tally</h1>
    <div class="text-muted">Counts from each person's active (submitted) answers that you can see.</div>
  </div>
  <div class="card-body">
    <%= render "team_filter", teams: @teams, team: @team, url: tally_form_path(@form), keep: {} %>

    <% if @questions.empty? %>
      <p class="text-muted">This form has no choice or yes/no questions to count.</p>
    <% end %>
    <div class="row">
      <% @questions.each do |question| %>
        <div class="col-12 col-md-6 col-xl-4 mb-3">
          <h2 class="h6"><%= question.label %></h2>
          <table class="table table-sm">
            <tbody>
              <% @report.tally(question).each do |value, count| %>
                <tr class="<%= "text-muted" if value.nil? %>">
                  <td><%= form_tally_label(value) %></td>
                  <td class="text-end"><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
  <div class="card-footer">
    <%= link_to "Back", form_path(@form, team_id: @team&.id), class: "btn btn-warning" %>
  </div>
</div>
