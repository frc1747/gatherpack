<% breadcrumb :form_tally, @form %>

<div class="card">
  <div class="card-header">
    <h1><%= @form.title %>: Tally</h1>
    <div class="text-muted">
      <% if @shared %>
        Totals from everyone's submitted answers. Nobody's individual answers are shown.
      <% else %>
        Counts from each person's active (submitted) answers that you can see.
      <% end %>
    </div>
  </div>
  <div class="card-body">
  <% unless @shared %>
    <%= form_with url: tally_form_path(@form), method: :get, class: "mb-3" do %>
      <h2 class="h6">Who's counted</h2>
      <div class="mb-2"><%= render "population_fields", population: @population, forms: @source_forms %></div>
      <%= submit_tag "Count", class: "btn btn-secondary", name: nil %>
    <% end %>
    <% if @population.ready? %>
      <p>People: <%= @population.description %></p>
      <% if @population.hidden_count.positive? %>
        <p class="text-muted">Not counted: <%= pluralize(@population.hidden_count, "person", plural: "people") %> whose answer to "<%= @population.question.label %>" you can't see.</p>
      <% end %>
    <% else %>
      <p class="text-warning-emphasis"><%= @population.missing %></p>
    <% end %>
  <% end %>

    <% if @questions.empty? %>
      <p class="text-muted">This form has no choice or yes/no questions to count.</p>
    <% end %>
    <div class="row">
      <% @questions.each do |question| %>
        <div class="col-12 col-md-6 col-xl-4 mb-3">
          <h2 class="h6"><%= question.label %></h2>
          <table class="table table-sm">
            <tbody>
              <% @report.tally(question).each do |value, count| %>
                <tr class="<%= "text-muted" if value.nil? %>">
                  <td><%= form_tally_label(value) %></td>
                  <td class="text-end"><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
  <div class="card-footer">
    <%= link_to "Back", @shared ? forms_path : form_path(@form, team_id: @population&.team&.id), class: "btn btn-warning" %>
  </div>
</div>
