<%# Adds a "checklist" audience rule (Checklists::FormAudienceTarget). %>
<% checklists = policy_scope(Checklist).where.not(status: :archived).order(:title).select { |checklist| policy(checklist).update? } %>
<% if checklists.any? %>
  <div class="col-lg-4">
    <%= simple_form_for FormAudienceRule.new(target_type: :checklist), url: form_audience_rules_path(form) do |r| %>
      <%= r.input :target_type, as: :hidden %>
      <div class="input-group mb-2">
        <%= r.select :effect, effects, {}, class: "form-select flex-grow-0 w-auto" %>
        <%= r.select :checklist_id, checklists.map { |checklist| [ checklist.title, checklist.id ] }, { prompt: "Checklist…" }, class: "form-select", required: true %>
      </div>
      <%= r.input :checklist_match, label: false, include_blank: false, wrapper_html: { class: "mb-2" },
            collection: [ [ "Everyone it covers", "covered" ], [ "People who have finished it", "met" ], [ "People who haven't finished it", "not_met" ] ] %>
      <%= r.button :submit, "Add checklist", class: "btn btn-sm btn-secondary" %>
    <% end %>
  </div>
<% end %>
