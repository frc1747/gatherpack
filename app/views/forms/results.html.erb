<% breadcrumb :form_results, @form %>
<% questions = @report.questions %>

<div class="card">
  <div class="card-header">
    <h1><%= @form.title %>: Results</h1>
    <div class="text-muted">
      <%= @version == :latest ? "Showing unsubmitted and unsigned updates where they exist, marked as such." : "Showing each person's active (submitted) version." %>
    </div>
  </div>
  <div class="card-body">
    <%= form_with url: results_form_path(@form), method: :get, class: "mb-3" do %>
      <div class="row g-2 align-items-end">
        <div class="col-auto">
          <%= label_tag :team_id, "Team", class: "form-label" %>
          <%= select_tag :team_id, options_from_collection_for_select(@teams, :id, :name, @team&.id), include_blank: "All of #{@teams.first.name}", class: "form-select" %>
        </div>
        <div class="col-auto">
          <%= label_tag :version, "Show", class: "form-label" %>
          <%= select_tag :version, options_for_select([ [ "Active (submitted)", "active" ], [ "Latest, including updates in progress", "latest" ] ], @version.to_s), class: "form-select" %>
        </div>
        <% if @profile_fields.any? %>
          <div class="col-md">
            <%= label_tag "field_ids[]", "Profile columns", class: "form-label" %>
            <%= select_tag "field_ids[]", options_from_collection_for_select(@profile_fields, :id, :name, @selected_fields.map(&:id)), multiple: true, class: "form-select", size: [ @profile_fields.size, 4 ].min %>
          </div>
        <% end %>
        <div class="col-auto">
          <%= submit_tag "Show", class: "btn btn-secondary", name: nil %>
        </div>
      </div>
    <% end %>

    <div class="table-responsive">
      <table class="table table-striped table-sm align-middle">
        <thead>
          <tr>
            <th>Person</th>
            <th>Status</th>
            <% questions.each do |question| %><th><%= question.label %></th><% end %>
            <% @selected_fields.each do |field| %><th class="table-info"><%= field.name %></th><% end %>
            <th>Version</th>
          </tr>
        </thead>
        <tbody>
          <% @report.rows.each do |row| %>
            <tr id="<%= dom_id row.person %>">
              <td><%= link_to row.person.identifier_name, form_response_path(@form, row.person) %></td>
              <td><%= form_status_badge(row.status) %></td>
              <% questions.each do |question| %>
                <td>
                  <% if @report.readable?(row, question) %>
                    <%= form_answer_display(question, @report.answer(row, question)) if row.submission %>
                    <% if @report.changed_since_signed?(row, question) %>
                      <span class="badge text-bg-warning" title="Profile now: <%= form_csv_value(row.person.field_value(question.person_field)) %>">Profile changed</span>
                    <% end %>
                  <% else %>
                    <span class="text-muted" title="You can't see this answer">·</span>
                  <% end %>
                </td>
              <% end %>
              <% @selected_fields.each do |field| %>
                <td class="table-info"><%= row.access.field_access.readable?(field) ? person_field_display(field, row.person.field_value(field)) : "·" %></td>
              <% end %>
              <td>
                <% if row.submission %>
                  #<%= row.submission.number %>
                  <% unless row.submission.active? %><span class="badge text-bg-light"><%= FormsHelper::SUBMISSION_STATUS_LABELS.fetch(row.submission.status) %></span><% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer">
    <%= link_to "Back", form_path(@form, team_id: @team&.id), class: "btn btn-warning" %>
    <%= link_to "Download CSV", results_form_path(@form, format: :csv, team_id: @team&.id, version: @version, field_ids: @selected_fields.map(&:id)), class: "btn btn-primary" %>
  </div>
</div>
