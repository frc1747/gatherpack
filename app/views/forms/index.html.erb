<% breadcrumb :forms %>

<div class="card">
  <div class="card-header">
    <h1>My Forms</h1>
  </div>
  <div class="card-body">
    <% to_do, other = @entries.partition(&:to_do?) %>
    <h2 class="h5">To do</h2>
    <% if to_do.empty? %>
      <p class="text-muted">Nothing to fill in right now.</p>
    <% else %>
      <%= render "entries", entries: to_do %>
    <% end %>

    <% if other.any? %>
      <h2 class="h5 mt-4">Other forms</h2>
      <%= render "entries", entries: other %>
    <% end %>
  </div>
</div>

<% if policy(Form.new).new? %>
  <div class="card mt-3">
    <div class="card-header">
      <h2>Manage Forms</h2>
    </div>
    <div class="card-body">
      <% if @managed.empty? %>
        <p class="text-muted">No forms yet.</p>
      <% else %>
        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead>
              <tr><th>Form</th><th>Team</th><th>Status</th><th>Deadline</th></tr>
            </thead>
            <tbody>
              <% @managed.each do |form| %>
                <tr id="<%= dom_id form %>">
                  <td><%= link_to form.title, form_path(form) %></td>
                  <td><%= form.team.name %></td>
                  <td><%= form_state_badge(form) %></td>
                  <td><%= form.closes_at ? nice_datetime(form.closes_at) : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
    <div class="card-footer">
      <%= link_to "New Form", new_form_path, class: "btn btn-primary" %>
      <% if current_user.admin? && GatherPack::Features.enabled?(:badges) %>
        <div class="form-text mt-2">
          <% if (creator_badge = Form.creator_badge) %>
            Holders of the <%= creator_badge.name %> badge can also create event forms for their own teams, and run only the forms they created.
          <% else %>
            Only admins and team managers create forms. To let others (say, student leaders) create event forms, set a Form Creator Badge in Settings.
          <% end %>
        </div>
      <% end %>
      <%= link_to "Printable list", print_list_forms_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
