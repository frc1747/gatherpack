<% breadcrumb :form, @form %>
<% form_policy = policy(@form) %>
<% manage = form_policy.manage? %>
<% counts = @report.status_counts %>
<% tallied = @report.questions.select { |question| form_tallyable?(question) } %>
<% more_open = @version == :latest || @options.key?(:columns_for) || @selected_fields.any? || @population.source == "answered" %>

<%# table-filter covers the whole card, so Download CSV in the filter bar
    carries the heading filters and sort, and form-results can keep the
    labels and totals to the rows they leave on screen. %>
<div class="card" data-controller="form-results table-filter" data-form-results-hidden-value="<%= @totals_hidden %>">
  <% summary = capture do %>
    <%= @form.form_audience_rules.map(&:description).to_sentence.presence || "Asks nobody yet" %><% if @form.audience_badge && Form.badges_enabled? %>, <%= @form.audience_badge.name %> badge holders only<% end %>
    <% if @form.event %>· For <%= GatherPack::Features.enabled?(:events) ? link_to(@form.event.name, event_path(@form.event)) : @form.event.name %><% end %>
    <% if @form.completion_badge && Form.badges_enabled? %>· Completion badge: <%= @form.completion_badge.name %><% end %>
  <% end %>
  <% setting = manage && (@form.draft? || @form.closed?) %>
  <%= render "shared/page_header", title: @form.title, summary: summary,
        state: state_line(form_taking_answers(@form), link_text: ("Start taking answers" if setting), link_path: (edit_form_path(@form, tab: "responses") if setting)) %>
  <div class="card-body">
    <% if @form.description.present? %>
      <div class="mb-3 no-print"><%= form_markdown(@form.description) %></div>
    <% end %>

    <% more = capture do %>
    <div class="border rounded p-3">
      <h2 class="h6">Show</h2>
      <div class="mb-3">
        <div class="form-check">
          <%= radio_button_tag :version, "active", @version == :active, class: "form-check-input" %>
          <%= label_tag :version_active, "Active (submitted)", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= radio_button_tag :version, "latest", @version == :latest, class: "form-check-input" %>
          <%= label_tag :version_latest, "Latest, including updates in progress", class: "form-check-label" %>
        </div>
      </div>

      <h2 class="h6">Columns</h2>
      <div class="row g-2 mb-3">
        <div class="col-md-6">
          <div class="form-label">Answers</div>
          <%= hidden_field_tag :columns_for, @form.id %>
          <% { "show_status" => [ "Status", @show_status ], "show_submitted" => [ "Submitted", @show_submitted ] }.each do |name, (label, checked)| %>
            <div class="form-check">
              <%= check_box_tag name, "1", checked, class: "form-check-input" %>
              <%= label_tag name, label, class: "form-check-label" %>
            </div>
          <% end %>
          <%= render "forms/tick_list", groups: [ [ nil, @report.questions.map { |question| { name: "question_ids[]", value: question.id, id: "question_ids_#{question.id}", label: question.label, checked: @questions.include?(question) } } ] ] %>
          <% if @report.questions.empty? %><div class="form-text">This form has no questions to show.</div><% end %>
        </div>
        <% if @profile_fields.any? %>
          <div class="col-md-6">
            <div class="form-label">Profile details</div>
            <% field_groups = @profile_fields.group_by(&:person_field_group).map do |group, fields|
                 [ group&.name, fields.map { |field| { name: "field_ids[]", value: field.id, id: "field_ids_#{field.id}", label: field.name, checked: @selected_fields.include?(field) } } ]
               end %>
            <%= render "forms/tick_list", groups: field_groups %>
          </div>
        <% end %>
      </div>

      <h2 class="h6">Who to include</h2>
      <div class="mb-3">
        <% if @source_forms %>
          <%= render "population_fields", population: @population, forms: @source_forms %>
        <% else %>
          <%= turbo_frame_tag "who_to_include", src: form_path(@form, frame: "who_to_include"), loading: :lazy do %>
            <p class="text-muted mb-0">Loading…</p>
          <% end %>
        <% end %>
      </div>
      <% if @population.ready? %>
        <% if @population.hidden_count.positive? %>
          <p class="text-muted">Not included: <%= pluralize(@population.hidden_count, "person", plural: "people") %> whose answer to "<%= @population.question.label %>" you can't see.</p>
        <% end %>
      <% else %>
        <p class="text-warning-emphasis"><%= @population.missing %></p>
      <% end %>
    </div>
    <% end %>
    <% layout_choice = capture do %>
      <div class="form-check form-check-inline mb-0">
        <%= radio_button_tag :layout, "list", @layout == "list", class: "form-check-input", form: "form-options", data: { action: "form-results#chooseLayout" } %>
        <%= label_tag :layout_list, "Table", class: "form-check-label" %>
      </div>
      <div class="form-check form-check-inline mb-0">
        <%= radio_button_tag :layout, "labels", @layout == "labels", class: "form-check-input", form: "form-options", data: { action: "form-results#chooseLayout" } %>
        <%= label_tag :layout_labels, "Labels", class: "form-check-label" %>
      </div>
    <% end %>
    <% statuses = [ { label: "All", count: @report.rows.size, value: nil } ] +
         FormReport::STATUSES.map { |status| { label: FormsHelper::STATUS_LABELS.fetch(status), count: counts[status], value: status } } %>
    <div class="no-print">
      <%= render "shared/filter_bar", url: form_path(@form), form_id: "form-options",
            teams: @teams, team: @team, all_teams_label: "All of #{@teams.first&.name}",
            statuses: statuses, status: @status,
            params: @options.except(:team_id, :status), hidden: { totals: ("hidden" if @totals_hidden) },
            more: more, open: more_open,
            table_actions_html: layout_choice,
            table_actions: [
              screen_action("Print", nil, style: :dark, data: { action: "form-results#print" }),
              screen_action("Download CSV", form_path(@form, @options.except(:layout, :totals).merge(format: :csv)), data: { table_filter_carry: true })
            ] %>
    </div>

    <% if @population.source == "answered" && @population.ready? %>
      <p>People: <%= @population.description %></p>
      <% if @not_shown_count.to_i.positive? %>
        <p class="text-muted" id="not-shown">Not shown: <%= pluralize(@not_shown_count, "person", plural: "people") %> whose answers you can't see.</p>
      <% end %>
    <% end %>
    <% outside = @outside || [] %>
    <%# Keys for the headings, carried with the filters to the CSV. %>
    <% columns = (@show_status ? [ [ "Status", ->(row) { form_results_status_cell(row) }, { data: { column_key: "status" } } ] ] : []) +
         (@show_submitted ? [ [ "Submitted", ->(row) { form_results_submitted_cell(@form, row) }, { data: { column_key: "submitted" } } ] ] : []) +
         @questions.map { |question| [ question.label, ->(row) { form_results_answer_cell(@report, row, question) }, { data: { column_key: question.id } } ] } +
         @selected_fields.map { |field| [ field.name, ->(row) { form_results_profile_cell(row, field) }, { class: "table-info", data: { column_key: field.id } } ] } %>
    <% havent_answered = capture do %>
      <% if outside.any? %>
        <tr class="table-light" id="havent-answered"><th colspan="<%= 1 + (@show_status ? 1 : 0) + (@show_submitted ? 1 : 0) + @questions.size + @selected_fields.size %>">Haven't answered (<%= outside.size %>)</th></tr>
        <% outside.each do |line| %>
          <tr id="<%= dom_id line.person %>">
            <td><%= line.person.identifier_name %></td>
            <% if @show_status %><td>—</td><% end %>
            <% if @show_submitted %><td>—</td><% end %>
            <% @questions.each do %><td></td><% end %>
            <% @selected_fields.each do |field| %>
              <td class="table-info"><%= @outside_list.profile_readable?(line, field) ? person_field_display(field, @outside_list.profile(line, field)) : "·" %></td>
            <% end %>
          </tr>
        <% end %>
      <% end %>
    <% end %>

    <%= render "shared/people_table", rows: @rows, columns: columns,
          link: ->(row) { form_response_path(@form, row.person) },
          table_class: "table table-striped table-sm align-middle",
          wrapper: { id: "responses", class: ("d-print-none" if @layout == "labels"), data: { form_results_target: "table" } },
          rows_after: havent_answered %>

    <% unless @rows.empty? && outside.empty? %>
      <%= tag.div class: [ "row g-2 d-none", ("d-print-flex" if @layout == "labels") ], id: "labels", data: { form_results_target: "labels" } do %>
        <% @rows.each do |row| %>
          <div class="col-6 col-lg-4" data-form-results-target="label" data-person="<%= dom_id row.person %>">
            <div class="border rounded p-2 h-100" style="page-break-inside: avoid;">
              <div class="fw-bold"><%= row.person.identifier_name %></div>
              <% @questions.each do |question| %>
                <% value = @report.answer(row, question) %>
                <% next if value.blank? %>
                <div><small class="text-muted"><%= question.label %>:</small> <%= form_csv_value(value) %></div>
              <% end %>
              <% @selected_fields.each do |field| %>
                <% value = @report.profile(row, field) %>
                <% next if value.blank? %>
                <div><small class="text-muted"><%= field.name %>:</small> <%= form_csv_value(value) %></div>
              <% end %>
            </div>
          </div>
        <% end %>
        <% outside.each do |line| %>
          <div class="col-6 col-lg-4" data-form-results-target="label" data-person="<%= dom_id line.person %>">
            <div class="border rounded p-2 h-100" style="page-break-inside: avoid;">
              <div class="fw-bold"><%= line.person.identifier_name %></div>
              <div><small class="text-muted">Haven't answered</small></div>
              <% @selected_fields.each do |field| %>
                <% value = @outside_list.profile(line, field) %>
                <% next if value.blank? %>
                <div><small class="text-muted"><%= field.name %>:</small> <%= form_csv_value(value) %></div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if tallied.any? %>
      <div class="d-flex justify-content-end no-print">
        <%= link_to @totals_hidden ? "Show totals" : "Hide totals", form_path(@form, @options.merge(totals: @totals_hidden ? nil : "hidden").compact_blank),
              class: "small", data: { form_results_target: "toggle", action: "form-results#toggleTotals" } %>
      </div>
      <%= tag.div id: "totals", hidden: @totals_hidden, data: { form_results_target: "totals" } do %>
        <h2 class="h5">Totals</h2>
        <%= render "totals", report: @report, questions: tallied, rows: @rows, recount: true %>
      <% end %>
    <% end %>
  </div>
  <div class="card-footer no-print">
    <% if manage %>
      <% waiting = @remind_report.rows.count { |row| !%w[ complete no_longer_asked ].include?(row.status) } %>
      <% actions = [
           screen_action("Edit", edit_form_path(@form), style: :warning),
           screen_action("Remind (#{waiting})", reminder_form_path(@form, team_id: @team&.id), style: :primary, visible: @form.open? && waiting.positive?),
           screen_action("Preview as…", preview_form_path(@form)),
           screen_action("Duplicate", duplicate_form_path(@form), method: :post, more: true),
           screen_action("Archive", archive_form_path(@form), method: :post, lifecycle: true, visible: !@form.archived?,
             confirm: "Archive this form? It's hidden from lists; responses are kept."),
           screen_action("Delete", form_path(@form), method: :delete, destructive: true, visible: form_policy.destroy?,
             confirm: "Delete this form? It has no submitted responses.")
         ] %>
      <div id="actions"><%= render "shared/action_row", actions:, wrapper_class: "" %></div>
    <% end %>
    <% if (last = @form.form_reminders.order(:sent_at).last) %>
      <div class="form-text mt-2">Last reminder: <%= nice_datetime(last.sent_at) %> to <%= pluralize(last.recipient_count, "person", plural: "people") %><%= form_reminder_guardian_note(last) %><%= " by #{last.sent_by.identifier_name}" if last.sent_by %>.</div>
    <% end %>
  </div>
</div>
