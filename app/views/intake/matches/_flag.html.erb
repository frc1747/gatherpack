<%# "Might be the same person as <name>. Link or keep separate." For managers only. %>
<% if member && (match = member.possible_match) %>
  <% link = Intake::MatchLink.new(member) %>
  <div class="d-flex flex-wrap align-items-center gap-2 mt-1" id="<%= dom_id(member, :match) %>">
    <span class="badge text-bg-info">Might be the same person as <%= link_to match.display_name, person_path(match), class: "link-dark" %></span>
    <%= button_to "Link", link_intake_registration_match_path(registration, member), class: "btn btn-sm btn-outline-primary",
      form: { data: { turbo_confirm: "#{link.description} Link?" } } %>
    <%= button_to "Keep separate", keep_separate_intake_registration_match_path(registration, member), class: "btn btn-sm btn-outline-secondary" %>
  </div>
<% end %>
