<%# Approve or deny the ticked applications on a team's page. Rows tick
    into this form through the form attribute (intake_bulk_form_id). %>
<% if Intake.enabled? && applications.any? && policy(team).applications? %>
  <%= form_with url: intake_team_bulk_decisions_path(team), id: intake_bulk_form_id(team), class: "d-flex flex-wrap gap-2 align-items-center mb-3" do %>
    <span class="text-muted">Ticked:</span>
    <%= button_tag "Approve", name: "decision", value: "approved", class: "btn btn-sm btn-success" %>
    <%= label_tag "bulk_reason_#{team.id}", "Reason", class: "visually-hidden" %>
    <%= text_field_tag :reason, nil, id: "bulk_reason_#{team.id}", placeholder: "Reason (sent to them)", class: "form-control form-control-sm w-auto" %>
    <%= button_tag "Deny", name: "decision", value: "denied", class: "btn btn-sm btn-outline-danger",
      data: { turbo_confirm: "Deny the ticked applications?" } %>
    <span class="small text-muted">Approve skips anyone whose checklist approval waits for, or who needs a team picked.</span>
  <% end %>
<% end %>
