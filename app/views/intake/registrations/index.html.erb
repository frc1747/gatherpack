<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Registrations<%= " for #{@team.name}" if @team %></h1>
    <div class="d-flex gap-2">
      <% if params[:archived] == "1" %>
        <%= link_to "Hide archived", request.path, class: "btn btn-outline-secondary" %>
      <% else %>
        <%= link_to "Show archived", "#{request.path}?archived=1", class: "btn btn-outline-secondary" %>
      <% end %>
      <%= link_to "New Registration", @team ? new_intake_team_registration_path(@team) : new_intake_registration_path, class: "btn btn-success" %>
    </div>
  </div>
  <div class="card-body">
    <% if @registrations.any? %>
      <table class="table align-middle mb-0">
        <thead>
          <tr><th>Title</th><th>Team</th><th>Opens</th><th>Closes</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% @registrations.each do |registration| %>
            <tr>
              <td><%= link_to registration.title, intake_registration_path(registration) %></td>
              <td><%= as_badge registration.team %></td>
              <td><%= l registration.opens_at, format: :short %></td>
              <td><%= registration.closes_at ? l(registration.closes_at, format: :short) : "No end" %></td>
              <td><%= registration.open? ? "Open" : (registration.not_yet_open? ? "Not open yet" : "Closed") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted mb-0">No registrations yet.</p>
    <% end %>
  </div>
</div>
