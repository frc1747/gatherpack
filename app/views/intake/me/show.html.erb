<% content_for :title, @registration.title %>
<h1 class="h3"><%= @registration.title %></h1>

<% if @applications.empty? && @person.memberships.where(team: @registration.apply_teams).none? %>
  <p>You haven't joined through this registration yet.</p>
  <% if @registration.self_service_open? %>
    <p><%= link_to "Join", intake_join_path(@registration.slug), class: "btn btn-primary" %></p>
  <% end %>
<% end %>

<div class="card mb-3">
  <div class="card-body d-flex flex-wrap align-items-center gap-2">
    <span>Your email: <strong><%= current_user.email %></strong></span>
    <details>
      <summary class="btn btn-sm btn-outline-secondary">Change email</summary>
      <%= form_with url: intake_me_email_path(@registration.slug), class: "d-flex gap-2 mt-2" do %>
        <%= email_field_tag :email, nil, required: true, class: "form-control form-control-sm", aria: { label: "New email" } %>
        <%= submit_tag "Send a link", class: "btn btn-sm btn-primary" %>
      <% end %>
    </details>
  </div>
</div>

<% @people.each do |person| %>
  <% applications = @applications[person.id] || [] %>
  <% next if person != @person && applications.empty? %>
  <div class="card mb-3" id="<%= dom_id(person, :intake) %>">
    <div class="card-header"><strong><%= person == @person ? "You" : person.display_name %></strong></div>
    <div class="card-body">
      <% applications.each do |application| %>
        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
          <div><%= application.team.name %>: <span class="fw-semibold"><%= intake_status_label(application) %></span></div>
          <% if application.pending? %>
            <%= button_to "Withdraw", intake_me_application_path(@registration.slug, application), method: :delete,
              class: "btn btn-sm btn-outline-secondary", form: { data: { turbo_confirm: "Withdraw this application?" } } %>
          <% end %>
        </div>
      <% end %>
      <% applications.select { |application| application.denied? && application.reviewer_notes.present? }.each do |application| %>
        <p class="text-muted small mt-2"><%= application.team.name %>: <%= application.reviewer_notes %></p>
      <% end %>

      <% if person.birthday.nil? %>
        <%= form_with url: intake_me_person_path(@registration.slug, person), method: :patch, scope: :person, class: "mt-3" do |f| %>
          <%= f.label :birthday, person == @person ? "Your birthday" : "#{person.first_name}'s birthday", class: "form-label" %>
          <div class="d-flex gap-2">
            <%= f.date_field :birthday, required: true, max: Date.current, class: "form-control", style: "max-width: 14rem;" %>
            <%= f.submit "Save", class: "btn btn-outline-primary" %>
          </div>
        <% end %>
      <% end %>

      <% if person == @person && @registration.guardian_relationship_type && Intake.person_needs_guardian?(person) && !person.guardians.exists? %>
        <% waiting = @guardian_rows.select { |row| row.facts["ward_id"] == person.id && row.guardian_confirmed_at.nil? } %>
        <% if waiting.any? %>
          <p class="mt-3 mb-0">Waiting for <%= waiting.map { |row| row.facts["first_name"] }.to_sentence %> to confirm they're your guardian.</p>
        <% elsif applications.any? %>
          <%= form_with url: intake_me_guardians_path(@registration.slug), scope: :guardian, class: "mt-3" do |f| %>
            <p class="mb-2">Who is your guardian? We'll ask them to confirm.</p>
            <div class="row">
              <div class="col-sm-6 mb-2"><%= f.text_field :first_name, required: true, placeholder: "First name", class: "form-control", aria: { label: "Guardian's first name" } %></div>
              <div class="col-sm-6 mb-2"><%= f.text_field :last_name, required: true, placeholder: "Last name", class: "form-control", aria: { label: "Guardian's last name" } %></div>
            </div>
            <div class="mb-2"><%= email_field_tag :guardian_email, nil, required: true, placeholder: "Email", class: "form-control", aria: { label: "Guardian's email" } %></div>
            <%= f.submit "Ask my guardian", class: "btn btn-outline-primary" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @registration.guardian_relationship_type && !Intake.person_needs_guardian?(@person) && @registration.open? %>
  <div class="card mb-3">
    <div class="card-header"><strong>Anyone else joining with you?</strong></div>
    <div class="card-body">
      <%= form_with url: intake_me_members_path(@registration.slug), scope: :member do |f| %>
        <% teams = @registration.apply_teams %>
        <% if teams.many? %>
          <fieldset class="mb-2">
            <legend class="form-label fs-6">Joining (choose any that apply)</legend>
            <% teams.each do |team| %>
              <div class="form-check">
                <%= check_box_tag "member[team_ids][]", team.id, false, id: "member_team_#{team.id}", class: "form-check-input" %>
                <%= label_tag "member_team_#{team.id}", team.name, class: "form-check-label" %>
              </div>
            <% end %>
          </fieldset>
        <% end %>
        <div class="row">
          <div class="col-sm-6 mb-2"><%= f.label :first_name, "First name", class: "form-label" %><%= f.text_field :first_name, required: true, class: "form-control" %></div>
          <div class="col-sm-6 mb-2"><%= f.label :last_name, "Last name", class: "form-label" %><%= f.text_field :last_name, required: true, class: "form-control" %></div>
        </div>
        <div class="mb-2"><%= f.label :birthday, "Birthday", class: "form-label" %><%= f.date_field :birthday, max: Date.current, class: "form-control", style: "max-width: 14rem;" %></div>
        <%= f.submit "Add", class: "btn btn-outline-primary" %>
      <% end %>
    </div>
  </div>
<% end %>
