<%# One person's results on the registration's checklist, on their
    registration page: unmet first, each with what to do. A guardian sees a
    ward's the same way and acts for them where the item lets them. %>
<% if status %>
  <% checklist = registration.checklist %>
  <div class="mt-3" id="<%= dom_id(person, :intake_checklist) %>">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h6 mb-0"><%= self_view ? "Your checklist" : "#{person.first_name}'s checklist" %></h2>
      <%= checklist_status_badge(status.overall) if status.overall %>
    </div>
    <ul class="list-group">
      <% status.explained.each do |entry| %>
        <li class="list-group-item d-flex justify-content-between align-items-start gap-2">
          <div>
            <div><%= entry.item.label %></div>
            <% if entry.full? && (text = entry.detail.presence || entry.summary).present? %>
              <div class="small text-body-secondary"><%= text %></div>
            <% end %>
          </div>
          <div class="text-end text-nowrap">
            <%= checklist_status_badge(entry) %>
            <div class="mt-1"><%= checklist_fix(checklist, entry, status.person_id) if entry.full? %></div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
