<% candidate = @team ? @membership.person : @membership.team %>
<% if @membership.persisted? %>
  <%= turbo_stream.replace dom_id(candidate, :candidate), partial: "shared/add_candidate", locals: { record: candidate, state: :added } %>
  <% if @team %>
    <%= turbo_stream.remove dom_id(@membership.person, :grid) %>
    <%= turbo_stream.prepend "people_grid", partial: "memberships/grid_membership", locals: { membership: @membership, col_class: member_grid_col_class(true) } %>
  <% else %>
    <%= turbo_stream.remove "no_memberships" %>
    <%= turbo_stream.prepend "memberships", partial: "memberships/person_membership", locals: { m: @membership } %>
  <% end %>
<% elsif candidate %>
  <%= turbo_stream.replace dom_id(candidate, :candidate), partial: "shared/add_candidate", locals: {
        record: candidate,
        add_url: @team ? team_memberships_path(@team, format: :turbo_stream) : person_memberships_path(@person, format: :turbo_stream),
        add_params: { membership: @team ? { person_id: candidate.id } : { team_id: candidate.id } },
        errors: @membership.errors.full_messages
      } %>
<% end %>
