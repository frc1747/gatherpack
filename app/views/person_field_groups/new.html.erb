<% breadcrumb :person_field_group, @person_field_group %>

<%= simple_form_for(@person_field_group) do |f| %>
  <div class="card">
    <div class="card-header">
      <h1>New Section</h1>
    </div>
    <div class="card-body">
      <%= render "form", f: f %>
    </div>
    <div class="card-footer">
      <%= link_to "Cancel", person_field_groups_path, class: "btn btn-warning" %>
      <%= f.button :submit, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
