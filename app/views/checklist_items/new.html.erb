<% breadcrumb :checklist_item, @item %>

<div class="card">
  <div class="card-header"><h1>Add <%= @item.kind_label.downcase_first %> item</h1></div>
  <div class="card-body">
    <% if @item.kind_class %>
      <%= render "form", checklist: @checklist, item: @item, impact: @impact %>
    <% else %>
      <p>That kind of item isn't available. <%= link_to "Back to the checklist", edit_checklist_path(@checklist, anchor: "items") %></p>
    <% end %>
  </div>
</div>
