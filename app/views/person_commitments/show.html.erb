<%= render "people/show_shared" %>

<div class="card">
  <%= render "shared/page_header", title: "#{@person.identifier_name}: Commitments" %>
  <div class="card-body">
    <% if @progress.any? %>
      <% @progress.each do |progress| %>
        <%= render "commitments/progress", progress: progress %>
      <% end %>
    <% else %>
      <%= render "shared/empty_state", text: "No commitments." %>
    <% end %>
  </div>
</div>
