<% breadcrumb :checklist_list, @list %>

<div class="card" data-controller="checklist-report">
  <%= render "shared/page_header", title: @list.configuration["title"],
        summary: "Taken #{l(@list.recorded_at, format: :long)} by #{@list.recorded_by&.display_name || "someone"}. This list doesn't change.",
        state: (tag.div(@list.note) if @list.note.present?) %>
  <div class="card-body" <%= tag.attributes(data: column_chooser_data("checklists-list")) %>>
    <div class="no-print">
      <%= render "shared/filter_bar", url: checklist_checklist_list_path(@list.checklist, @list),
            table_actions: [ screen_action("Print", nil, style: :dark, data: { action: "checklist-report#print" }) ] %>
    </div>
    <% items = Array(@list.configuration["items"]) %>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead>
          <tr><th>Name</th><th>Overall</th><% items.each do |item| %><th><%= item["label"] %></th><% end %></tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td><%= row["name"] %></td>
              <td><% if row["overall"] %><span class="badge <%= checklist_status_class(row["overall"]) %>"><%= row["overall_text"] %></span><% end %></td>
              <% items.each do |item| %>
                <% entry = row.dig("items", item["id"]) %>
                <td><% if entry %><span class="badge <%= checklist_status_class(entry["status"]) %>"><%= entry["text"] %></span> <small><%= entry["summary"] %></small><% end %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
