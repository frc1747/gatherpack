<%# A group shown on its feature's own page (Settings.page): one line with a link. %>
<% page = Settings.page_for(group) %>
<div class="card">
  <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-2">
    <h2 class="h5 mb-0"><%= group %></h2>
    <%= link_to page.label || "#{group} settings", setting_page_path(page), class: "btn btn-primary d-inline-flex align-items-center", style: "min-height: 44px" %>
  </div>
</div>
