<label class="form-label" for="<%= setting_input_id(input) %>"><%= setting.name %></label>
<%= select_tag "settings[#{setting.setting_key}]",
               options_for_select(input.choices, input.selected_value),
               include_blank: input.include_blank,
               id: setting_input_id(input), class: "form-select", style: "min-height: 44px" %>
