<%# The checklist rule's settings on the position's rules card. %>
<% choices = Checklists::SignupPositionRules.choices_for(current_user) %>
<% choices.unshift(rule.checklist) if rule.checklist && choices.exclude?(rule.checklist) %>
<%= r.input :checklist_id, label: "Checklist they must finish first", collection: choices, label_method: :title, value_method: :id,
      include_blank: "Choose a checklist",
      hint: "Only people who have already finished this checklist can take this position. People the checklist leaves out can never take it." %>
<%= r.input :accept_pending, label: "Also allow people partway through", hint: "Use this when signing up here is how people finish the checklist." %>
