<%# The checklist rule's settings on the position's rules card. %>
<% choices = Checklists::SignupPositionRules.choices_for(current_user).to_a %>
<% choices.unshift(rule.checklist) if rule.checklist && choices.exclude?(rule.checklist) %>
<%= r.input :checklist_id, label: "Checklist", collection: choices, label_method: :title, value_method: :id,
      include_blank: "Choose a checklist", hint: "People it doesn't cover can't take the place." %>
<%= r.input :accept_pending, label: "Almost done is enough", hint: "For when signing up is how people finish it." %>
