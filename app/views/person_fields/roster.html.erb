<% breadcrumb :person_field_roster %>

<%= form_with url: roster_person_fields_path, method: :get, class: "no-print" do %>
  <div class="card">
    <div class="card-header">
      <h1>Member Info</h1>
    </div>
    <div class="card-body">
      <% if @fields.empty? %>
        <p class="text-muted">There are no fields you can view for anyone.</p>
      <% else %>
        <div class="mb-3">
          <div class="form-label">Fields</div>
          <% @fields.each do |field| %>
            <div class="form-check form-check-inline">
              <%= check_box_tag "field_ids[]", field.id, @selected.include?(field), id: "field_#{field.id}", class: "form-check-input" %>
              <%= label_tag "field_#{field.id}", field.name, class: "form-check-label" %>
            </div>
          <% end %>
        </div>
        <div class="mb-3">
          <%= label_tag :team_id, "Team", class: "form-label" %>
          <%= select_tag :team_id, options_from_collection_for_select(@teams, :id, :name, params[:team_id]), include_blank: "Everyone you can see", class: "form-select" %>
        </div>
      <% end %>
    </div>
    <% if @fields.any? %>
      <div class="card-footer">
        <%= submit_tag "Show", class: "btn btn-primary", name: nil %>
        <% if @people %>
          <button type="button" class="btn btn-secondary" onclick="window.print()">Print</button>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @people %>
  <div class="card mt-3">
    <div class="card-body">
      <% if @people.empty? %>
        <p class="text-muted">Nobody to show.</p>
      <% else %>
        <table class="table table-striped table-sm">
          <thead>
            <tr>
              <th>Name</th>
              <% @selected.each do |field| %><th><%= field.name %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @people.each do |person| %>
              <tr>
                <td><%= link_to person.identifier_name, person %></td>
                <% @selected.each do |field| %>
                  <td>
                    <% if @readable[field.id].include?(person.id) %>
                      <%= person_field_display(field, field.system? ? person.field_value(field) : field.cast(@rows[[ person.id, field.id ]]&.value)) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
<% end %>
