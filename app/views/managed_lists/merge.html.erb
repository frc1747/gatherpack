<% breadcrumb :managed_list_row, @list, @row %>

<%= form_with url: merge_managed_list_row_path(@list.key, @row), method: :post do |f| %>
<div class="card">
  <div class="card-header">
    <h1>Merge <%= @row.name %> into…</h1>
  </div>
  <div class="card-body">
    <p>
      Everything that uses <strong><%= @row.name %></strong>
      (<%= @row.usage.map { |klass, count| pluralize(count, klass.model_name.human.downcase) }.to_sentence.presence || "nothing yet" %>)
      will use the <%= @list.label.downcase %> you choose instead, and <strong><%= @row.name %></strong> will be deleted.
    </p>
    <div class="mb-3">
      <%= f.label :target_id, "Merge into", class: "form-label" %>
      <%= f.select :target_id, @targets.map { |row| [ row.name, row.id ] }, { include_blank: true }, class: "form-select" %>
    </div>
  </div>
  <div class="card-footer">
    <%= link_to "Cancel", managed_list_path(@list.key), class: "btn btn-warning" %>
    <%= f.submit "Merge", class: "btn btn-danger" %>
  </div>
</div>
<% end %>
