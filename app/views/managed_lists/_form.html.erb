<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

<div class="form-inputs">
  <%= f.input :name %>
  <%= f.input :plural, hint: "Used where a count is shown. Leave blank for \"#{f.object.name.present? ? f.object.name.pluralize : "the name with an s"}\"." %>
  <% @list.fields.each do |field| %>
    <%= f.input field.name, { label: field.label, hint: field.hint, as: field.as }.compact %>
  <% end %>
</div>
