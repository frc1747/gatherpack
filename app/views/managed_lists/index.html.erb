<% breadcrumb :managed_list, @list %>

<div class="card">
  <div class="card-header">
    <h1><%= @list.plural_label %></h1>
  </div>
  <div class="card-body">
    <% if @list.description.present? %>
      <p><%= @list.description %></p>
    <% end %>
    <p class="text-muted mb-0">
      Retired <%= @list.plural_label.downcase %> stay on the records that already use them, but can't be picked for new ones.
      One that's in use can't be deleted: retire it, or merge it into another.
    </p>
  </div>
  <div class="card-footer">
    <%= link_to "New #{@list.label}", new_managed_list_row_path(@list.key), class: "btn btn-success" %>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header">
    <h2 class="h5 mb-0">Active</h2>
  </div>
  <ul class="list-group list-group-flush" id="managed_list_active">
    <% @rows.each_with_index do |row, index| %>
      <%= render "row", row: row, first: index.zero?, last: index == @rows.size - 1 %>
    <% end %>
    <% if @rows.empty? %>
      <li class="list-group-item text-muted">No <%= @list.plural_label.downcase %> yet.</li>
    <% end %>
  </ul>
</div>

<% if @retired_rows.any? %>
  <div class="card mt-3">
    <div class="card-header">
      <h2 class="h5 mb-0">Retired</h2>
    </div>
    <ul class="list-group list-group-flush" id="managed_list_retired">
      <% @retired_rows.each do |row| %>
        <%= render "row", row: row, first: true, last: true %>
      <% end %>
    </ul>
  </div>
<% end %>
