<% breadcrumb :managed_list_row, @list, @row %>

<%= simple_form_for(@row, as: :row, url: managed_list_rows_path(@list.key), method: :post) do |f| %>
<div class="card">
  <div class="card-header">
    <h1>New <%= @list.label.downcase %></h1>
  </div>
  <div class="card-body">
    <%= render "form", f: f %>
  </div>
  <div class="card-footer">
    <%= link_to "Cancel", managed_list_path(@list.key), class: "btn btn-warning" %>
    <%= f.button :submit, "Save", class: "btn btn-primary" %>
  </div>
</div>
<% end %>
