<div class="card" id="<%= dom_id report %>">
  <div class="card-header">
    <%= link_to report.identifier_name, report, data: { turbo_frame: "_top" } %>
  </div>
  <div class="card-footer">
    <%= link_to "Run", run_report_path(report), class: "btn btn-sm btn-success", data: { turbo_frame: "_top", turbo_prefetch: false } %>
  </div>
</div>
