<% breadcrumb :people %>

<%= search_form_for @q, data: {"controller": "turbo_search", "turbo_frame": "results"} do |f| %>
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h1>People</h1>
    <button class="btn btn-primary d-md-none" type="button" style="min-height: 44px"
            data-bs-toggle="collapse" data-bs-target=".people-search"
            aria-expanded="<%= params[:q].present? %>" aria-controls="people-search people-search-actions">
      Search
    </button>
  </div>
  <div id="people-search" class="people-search collapse d-md-block<%= " show" if params[:q].present? %>">
  <div class="card-body">
    <div class="row">
      <div class="col-md">
        <%= f.input :display_name_i_cont, label: "Name" %>
      </div>
      <% searchable = Person.ransackable_attributes(current_user) %>
      <% if searchable.include?("phone_number") %>
        <div class="col-md">
          <%= f.input :phone_number_i_cont, label: "Phone" %>
        </div>
      <% end %>
      <% if searchable.include?("address") %>
        <div class="col-md">
          <%= f.input :address_i_cont, label: "Address" %>
        </div>
      <% end %>
    </div>
  </div>
  </div>
  <div class="card-footer">
    <%= link_to "New Person", new_person_path, class: "btn btn-success" if policy(Person).new? %>
    <span id="people-search-actions" class="people-search collapse d-md-inline<%= " show" if params[:q].present? %>">
      <%= f.submit "Search", class: "btn btn-primary", data: { action: "turbo_search#search" } %>
      <%= link_to "Clear Search", request.path, class: "btn btn-dark", data: { action: "turbo_search#clear" } %>
    </span>
  </div>
</div>
<% end %>

<%= render "housekeeping/people_bar", search_form: "person_search" %>
<%= turbo_frame_tag "results" do %>
  <div class="dropdown">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      Sort By
    </button>
    <ul class="dropdown-menu">
      <li><%= sort_link @q, :last_name, "Last Name", class: "dropdown-item" %></li>
      <li><%= sort_link @q, :first_name, "First Name", class: "dropdown-item" %></li>
      <% if Person.ransackable_attributes(current_user).include?("birthday") %>
        <li><%= sort_link @q, :birthday, "Age", class: "dropdown-item" %></li>
      <% end %>
      <li><%= sort_link @q, :updated_at, "Last Updated", class: "dropdown-item" %></li>
    </ul>
  </div>

  <div id="people" class="row">
    <% @people.each do |person| %>
      <div class="col-md-3">
        <%= render person %>
      </div>
    <% end %>
  </div>

  <%= paginate @people %>
<% end %>
