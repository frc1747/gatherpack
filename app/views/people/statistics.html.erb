<%= render "show_shared" %>

<div class="card">
  <div class="card-header">
    <h1><%= @person.identifier_name %></h1>
  </div>
  <div class="card-body">
    <h2>General Statistics</h2>
    <p>Joined <%= time_ago_in_words(@person.created_at) %> ago</p>
    <% if GatherPack::Features.enabled?(:time_tracking) && @show_punches %>
      <p>Punched in <%= pluralize @hours, "hour" %></p>
    <% end %>
    <% if GatherPack::Features.enabled?(:events) %>
      <p>Checked in <%= pluralize @checkin_count, "event" %></p>
    <% end %>
    <% if GatherPack::Features.enabled?(:time_tracking) && @periods.any? %>
      <hr>
      <div class="row">
        <% @periods.each do |stats| %>
          <% period = stats[:period] %>
          <div class="col-md-6">
            <h3>Statistics for <%= as_badge period, link: true %></h3>
            <% if @show_punches %>
              <p>Punched in <%= pluralize stats[:hours], "hour" %> in this period.</p>
              <% if period.available_hours > 0 %>
                That's <%= (stats[:hours] / period.available_hours.to_f * 100).round(2) %>% of the <%= pluralize(period.available_hours, "hour") %> that have accumulated so far.
              <% end %>
            <% end %>
            <p>Checked in <%= pluralize stats[:checkin_count], "event" %> from this period.</p>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
