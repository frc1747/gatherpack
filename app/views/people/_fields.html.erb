<% fields = policy(person).readable_person_fields.select(&:show_on_profile) %>
<% if fields.any? %>
  <% rows = person.person_field_values.index_by(&:person_field_id) %>
  <% fields.group_by(&:person_field_group).each do |group, group_fields| %>
    <% if group %>
      <h5 class="mt-3"><%= group.name %></h5>
    <% end %>
    <% group_fields.each do |field| %>
      <p id="<%= dom_id field %>">
        <b><%= field.name %>: </b><%= person_field_display(field, person_field_current_value(person, field, rows)) %>
        <% if field.restricted? %>
          <span class="text-muted" title="<%= person_field_lock_title(field, person) %>"><%= i "lock" %></span>
        <% end %>
      </p>
    <% end %>
  <% end %>
<% end %>
