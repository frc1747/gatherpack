<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

<% if @person.new_record? || policy(@person).update_profile? %>
<div class="row" data-controller="photo-capture">
  <div class="col-md-4">
    <div class="row mb-2">
      <div class="col">
        <input type="button" class="btn btn-light w-100" value="Loading..." id="activate-webcam" data-photo-capture-target="activateWebcam">
      </div>
      <div class="col">
        <input type="button" class="btn btn-success w-100" value="Capture" id="capture-image" style="display: none" data-photo-capture-target="captureImage">
      </div>
    </div>

    <canvas id="capture-canvas" style="display: none" data-photo-capture-target="captureCanvas"></canvas>
    <img id="avatar-img" src="<%= get_avatar_url_512(@person.avatar) %>" data-photo-capture-target="avatarImg">
    <video id="capture-video" data-photo-capture-target="captureVideo"></video>

    <div class="row mt-2">
      <div class="col">
        <%= f.input :avatar, label: false, input_html: { id: "person_avatar", 'data-photo-capture-target': "personAvatar" } %>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="row">
      <div class="col-6 col-md-4">
        <%= f.input :first_name %>
      </div>
      <div class="col-6 col-md-4">
        <%= f.input :last_name %>
      </div>
      <div class="col-12 col-md-4">
        <%= f.input :display_name %>
      </div>
    </div>

    <div class="row">
      <div class="col-md">
        <%= f.simple_fields_for :user do |ff| %>
          <% if @person.user.provider %>
            <div class="alert alert-warning">
              This person signs in with <%= @person.user.provider %>
            </div>
          <% else %>
            <%= link_to "Change Email/Password", if @person.user.id then edit_person_user_path(@person) else new_person_user_path(@person) end, class: "btn btn-primary" %>
          <% end %>
        <% end %>
      </div>
      <div class="col-12">
        <%= f.input :bio, wrapper_html: { class: "code-editor" }, input_html: { rows: 8, data: { lang: "markdown" } } %>
      </div>
    </div>
  </div>
</div>
<% end %>

<%= render "people/field_inputs", f: f, person: @person %>
