<% breadcrumb @commitment %>

<%= simple_form_for(@commitment) do |f| %>
<div class="card">
  <div class="card-header">
    <h1>Editing <%= @commitment.identifier_name %></h1>
  </div>
  <div class="card-body">
    <%= render "form", f: f %>
  </div>
  <div class="card-footer">
    <%= link_to "Cancel", @commitment, class: "btn btn-warning" %>
    <%= f.button :submit, "Save", class: "btn btn-primary" %>
  </div>
</div>
<% end %>

<h2 class="mt-4">Set up the commitment</h2>

<%= render "manage_sources" %>
<%= render "manage_organizers" %>
