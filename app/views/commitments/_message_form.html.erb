<div class="card mb-3 no-print" id="message">
  <div class="card-header">
    <h2 class="h5 mb-0">Message people with open commitments</h2>
  </div>
  <div class="card-body">
    <p class="small text-body-secondary">Each person who hasn't met this commitment gets their own email, so nobody sees anyone else's address.</p>
    <%= form_with url: message_commitment_path(@commitment), method: :post do |f| %>
      <div class="mb-3">
        <%= f.label :subject, class: "form-label" %>
        <%= f.text_field :subject, class: "form-control", required: true %>
      </div>
      <div class="mb-3">
        <%= f.label :body, "Message", class: "form-label" %>
        <%= f.text_area :body, rows: 4, class: "form-control", required: true %>
      </div>
      <%= f.submit "Send", class: "btn btn-primary", data: { turbo_confirm: "Send this message to everyone with an open commitment?" } %>
    <% end %>
  </div>
</div>
