<% breadcrumb @commitment %>
<% who = "Everyone in #{@commitment.owing_team.name}#{" holding #{@commitment.owing_badge.name}" if @commitment.owing_badge}#{", except holders of #{@commitment.exempt_badge.name}," if @commitment.exempt_badge}" %>

<div class="card mb-3">
  <%= render "shared/page_header", title: @commitment.title,
        summary: "#{who} owes #{pluralize(@commitment.base_amount, @commitment.unit.singularize, plural: @commitment.unit)} by #{@commitment.ends_on.strftime("%b %-d, %Y")}",
        state: state_line("#{@commitment.team.name} · #{commitment_period(@commitment)}") %>
  <div class="card-body">
    <%= md @commitment.description if @commitment.description.present? %>
    <p class="<%= @rows ? "mb-3" : "mb-0" %>">
      <% if @commitment.grouped? %>
        People connected as <%= @commitment.group_relationship_type.identifier_name %> owe together, plus <%= @commitment.additional_amount %> for each member after the first.
      <% elsif @commitment.group_relationship_type && policy(@commitment).update? %>
        People connected as <%= @commitment.group_relationship_type.identifier_name %> don't owe together: members can add that relationship themselves.
        Pick a different relationship, one only admins or managers add, to group them again.
      <% end %>
      <%= @commitment.counts_planned? ? "Planned credit counts toward it." : "Only confirmed credit counts toward it." %>
    </p>
    <%= render "progress_table" if @rows %>
  </div>
  <% if policy(@commitment).update? %>
    <%= render "shared/action_row", wrapper_class: "card-footer no-print", actions: [
          screen_action("Edit", edit_commitment_path(@commitment, tab: "details"), style: :warning),
          screen_action("Remind (#{@open_count})", nil, style: :primary, visible: !@rows.nil? && policy(@commitment).message? && @open_count.to_i.positive?,
            data: { bs_toggle: "collapse", bs_target: "#message" }),
          screen_action("Add an adjustment", new_commitment_commitment_adjustment_path(@commitment), more: true),
          screen_action("Duplicate", duplicate_commitment_path(@commitment), method: :post, more: true, visible: policy(@commitment).duplicate?),
          screen_action("Delete", commitment_path(@commitment), method: :delete, destructive: true,
            confirm: "Delete this commitment and its adjustments?")
        ] %>
  <% end %>
</div>

<% if @own %>
  <%= render "commitments/progress", progress: @own %>
<% elsif policy(@commitment).message? %>
  <%= render "message_form" %>
<% end %>
