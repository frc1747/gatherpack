<%# Everyone's progress, one row per person or group, for organizers: names and numbers only. %>
<div <%= tag.attributes(data: column_chooser_data("commitments-progress")) %>>
<div class="no-print">
  <%= render "shared/filter_bar", url: commitment_path(@commitment), teams: @teams, team: @team, status: @status, auto_submit: true,
        statuses: [ { label: "All", value: nil, count: @status_counts.values_at("met", "not_met").sum } ] +
          CommitmentsController::STATUSES.map { |value, label| { label: label, value: value, count: @status_counts[value] } },
        table_actions: [ screen_action("Print", nil, style: :dark, data: { controller: "print", action: "print#print" }) ] %>
</div>

<% columns = [] %>
<% columns << [ "Owes with", ->(row) { row.members.drop(1).map(&:display_name).join(", ") } ] if @commitment.grouped? %>
<% columns += [
     [ "Owed", ->(row) { row.owed } ],
     [ "Confirmed", ->(row) { row.confirmed } ],
     [ "Planned", ->(row) { row.planned } ],
     [ "Remaining", ->(row) { row.remaining } ],
     [ "Breakdown", ->(row) { render "progress_breakdown", row: row }, { class: "small" } ],
     [ "", ->(row) { render "progress_adjust", row: row }, { class: "no-print text-nowrap" } ]
   ] %>
<%= render "shared/people_table", rows: @rows, link: nil, columns: columns, wrapper: { id: "progress" },
      table_class: "table table-striped table-sm align-middle",
      status: ->(row) { commitment_status_badge(row) },
      empty: (@team || @status ? "Nobody matches these choices." : "Nobody here.") %>
</div>
