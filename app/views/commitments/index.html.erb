<% breadcrumb :commitments %>

<div class="card mb-3">
  <%= render "shared/page_header", title: "Commitments", summary: "What you owe, and the commitments you run." %>
  <% if policy(Commitment).new? %>
    <div class="card-footer">
      <%= link_to "New Commitment", new_commitment_path, class: "btn btn-success" %>
    </div>
  <% end %>
</div>

<h2 class="h4">What you owe</h2>
<% if @owed.any? %>
  <% @owed.each do |progress| %>
    <%= render "commitments/progress", progress: progress %>
  <% end %>
<% else %>
  <%= render "shared/empty_state", text: "You don't owe anything right now." %>
<% end %>

<% if @run.any? || policy(Commitment).new? %>
  <h2 class="h4 mt-4">Commitments you run</h2>
  <% if @run.any? %>
    <div class="table-responsive" <%= tag.attributes(data: column_chooser_data("commitments-list")) %>>
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th data-column-chooser-fixed>Commitment</th>
            <th>Team</th>
            <th>Who owes</th>
            <th>Period</th>
          </tr>
        </thead>
        <tbody>
          <% @run.each do |commitment| %>
            <tr id="<%= dom_id commitment %>">
              <td><%= link_to commitment.title, commitment %></td>
              <td><%= commitment.team.name %></td>
              <td><%= commitment.owing_team.name %><%= " with #{commitment.owing_badge.name}" if commitment.owing_badge %></td>
              <td><%= commitment_period(commitment) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render "shared/empty_state", text: "You don't run any commitments yet." %>
  <% end %>
<% end %>
