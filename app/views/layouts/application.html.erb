<!DOCTYPE html>
<html>
  <head>
    <title> <%= Settings[:title] %> | <%= content_for(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <% if (favicon = Theme.instance.favicon_32) %>
      <link rel="icon" href="<%= url_for(favicon) %>" type="image/png">
    <% else %>
      <link rel="icon" href="/apple-touch-icon.png" type="image/png">
    <% end %>
    <% if (apple_touch = Theme.instance.apple_touch_icon) %>
      <link rel="apple-touch-icon" href="<%= url_for(apple_touch) %>">
    <% else %>
      <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <% end %>
    <%= stylesheet_link_tag "fonts" %>
    <link rel="preload" href="<%= asset_path("fira-sans-latin-400.woff2") %>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<%= asset_path("bubblegum-sans-latin-400.woff2") %>" as="font" type="font/woff2" crossorigin>
    <%= javascript_include_tag "popper.min" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "layouts/theme_styles" %>
    <%= javascript_importmap_tags %>
    <%= font_awesome_tag %>
  </head>

  <body>
    <%= render partial: "layouts/navbar" %>

    <div class="container-fluid">
      <div class="row">
        <% if (current_user.present? rescue false) %>
          <%= render partial: "layouts/sidebar" %>
        <% end %>

        <div class="<%= "col-md-9 ms-sm-auto col-lg-10" if (current_user.present? rescue false) %> px-md-4">
          <div class="card breadcrumb-container no-print">
            <%= breadcrumbs display_single_fragment: true, separator: "&nbsp&rsaquo;&nbsp", style: :inline, class: "breadcrumb", link_class: "breadcrumb-link", current_class: "breadcrumb-current" %>
          </div>

          <% if flash.any? %>
            <div class="my-3">
              <% flash.each do |type, value| %>
                <div class="alert <%= flash_to_class(type) %> alert-dismissible fade show" role="alert">
                  <i class="bi flex-shrink-0 me-2 fa-solid <%= flash_to_icon(type) %>"></i>
                  <%= value %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% end %>
            </div>
          <% end %>

          <% breadcrumb :root %>

          <main>
            <%= yield %>
          </main>
        </div>
      </div>
    </div>
    <button id="confirm-delete-trigger" type="button" class="d-none"
            data-bs-toggle="modal" data-bs-target="#confirm-delete-modal"></button>
    <div class="modal fade" id="confirm-delete-modal" tabindex="-1" aria-labelledby="confirm-delete-modal-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="confirm-delete-modal-label">Confirm Delete</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="confirm-delete-modal-message">
            Are you sure you want to delete this?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <form id="confirm-delete-form" method="post">
              <input type="hidden" name="_method" value="delete">
              <input type="hidden" id="confirm-delete-redirect-to" name="redirect_to" value="">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
