<!DOCTYPE html>
<html>
  <head>
    <title><%= Settings[:title] %> | <%= content_for(:title).presence || "Join" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if (favicon = Theme.instance.favicon_32) %>
      <link rel="icon" href="<%= url_for(favicon) %>" type="image/png">
    <% else %>
      <link rel="icon" href="/apple-touch-icon.png" type="image/png">
    <% end %>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bubblegum+Sans&family=Fira+Code:wght@300..700&family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= render "layouts/theme_styles" %>
    <%= javascript_importmap_tags %>
    <%= font_awesome_tag %>
  </head>

  <body>
    <header class="navbar bg-dark">
      <div class="container-fluid">
        <span class="navbar-brand">
          <% if Theme.instance.logo.attached? %>
            <%= image_tag Theme.instance.logo, alt: Settings[:title] %>
          <% else %>
            <%= image_tag "logo.svg", alt: "" %>
          <% end %>
          <%= Settings[:title] %>
        </span>
      </div>
    </header>

    <main class="container py-4" style="max-width: 40rem;">
      <% flash.each do |type, message| %>
        <div class="alert <%= flash_to_class(type) %>" role="alert"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
