<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

<div class="form-inputs">
  <%= f.input :name %>
  <%= f.input :redirect_uri, hint: "You can add more than one. Separate them with a space or a new line." %>
  <%= f.input :selected_scopes, as: :check_boxes, collection: Doorkeeper.configuration.scopes %>
  <%= f.input :confidential %>
</div>
