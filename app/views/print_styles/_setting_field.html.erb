<%# Print style on the settings page (Settings.input :partial). Locals: setting, input. %>
<label class="form-label" for="settings_print_css"><%= setting.name %></label>
<%= text_area_tag "settings[#{setting.setting_key}]", input.value, id: "settings_print_css", rows: 8, class: "form-control font-monospace" %>
