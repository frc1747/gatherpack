<% position = slot.signup_position %>
<% remaining = slot.remaining(excluding: signup) %>

<%= simple_form_for [ @signup_sheet, signup ] do |f| %>
  <div class="card">
    <div class="card-header">
      <h1><%= title %></h1>
      <%= position.name %>, <%= slot.event.name %>, <%= slot.event.start_time.strftime("%a %b %-d, %-l:%M %p") %>
    </div>
    <div class="card-body">
      <%= f.error_notification message: signup.errors[:base].to_sentence if signup.errors[:base].present? %>
      <%= md position.description if position.description.present? %>
      <%= f.hidden_field :signup_slot_id if signup.new_record? %>

      <% if taker_choices.size > 1 || taker_choices.exclude?(current_user.person) %>
        <%= f.input :person_id, as: :radio_buttons, label: "Who's taking the place?", collection: taker_choices,
              label_method: :identifier_name, value_method: :id, include_blank: false, wrapper: :vertical_collection_inline %>
      <% end %>

      <% unless @signup_sheet.on_behalf_of_nobody_else? %>
        <%= f.input :on_behalf_of_id, as: :radio_buttons, label: "Who is it on behalf of?",
              collection: [ [ "Whoever takes the place", "" ] ] + on_behalf_of_choices.map { |someone| [ someone.identifier_name, someone.id ] },
              checked: signup.on_behalf_of_id == signup.person_id ? "" : signup.on_behalf_of_id, include_blank: false, required: false,
              wrapper: :vertical_collection_inline, hint: "Pick someone when you're taking the place for them." %>
      <% end %>

      <% if position.items? %>
        <%= f.input :quantity, label: "How many #{position.unit_label}?", required: true,
              input_html: { min: 1, max: remaining },
              hint: remaining ? "#{remaining} still needed." : nil %>
      <% else %>
        <div class="row">
          <div class="col-12 col-md-4">
            <%= f.input :extra_people, label: "Anyone coming with you?", input_html: { min: 0, max: remaining && [ remaining - 1, 0 ].max },
                  required: false, hint: "How many people besides the person taking the place." %>
          </div>
          <div class="col-12 col-md-8">
            <%= f.input :extra_names, label: "Their names", required: false %>
          </div>
        </div>
      <% end %>

      <% if position.question.present? %>
        <%= f.input :answer, label: position.question, required: position.question_required? %>
      <% end %>

      <%= f.input :note, label: "Anything the organizers should know?", required: false, input_html: { rows: 2 } %>
    </div>
    <div class="card-footer">
      <%= link_to "Back", @signup_sheet, class: "btn btn-secondary" %>
      <%= f.button :submit, submit_label, class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
