<% access ||= FormAccess.new(current_user.person, submission.subject, submission.form) %>
<dl class="row mb-0">
  <% submission.form.answerable_questions.each do |question| %>
    <% next unless access.question_readable?(question) %>
    <% changed = previous && previous.answers[question.key] != submission.answers[question.key] %>
    <% if question.acknowledgment? %>
      <dd class="col-12 d-flex gap-2 mb-1">
        <span class="flex-shrink-0"><%= i(submission.answer(question) == true ? "square-check" : "square") %></span>
        <span>
          <%= question.label %>
          <% if changed %><span class="badge text-bg-light">changed</span><% end %>
        </span>
      </dd>
    <% else %>
      <dt class="col-sm-4"><%= question.label %></dt>
      <dd class="col-sm-8">
        <%= form_answer_display(question, submission.answer(question)) %>
        <% if changed %>
          <span class="badge text-bg-light" title="Was: <%= form_csv_value(previous.answer(question)) %>">changed</span>
        <% end %>
        <% if submission.profile_skipped.include?(question.key) %>
          <span class="badge text-bg-warning">Not copied to profile</span>
        <% end %>
      </dd>
    <% end %>
  <% end %>
</dl>
