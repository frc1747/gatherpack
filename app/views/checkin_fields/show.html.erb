<% breadcrumb @checkin_field %>

<div class="card">
  <div class="card-header">
    <h1><%= @checkin_field.identifier_name %></h1>
  </div>
  <div class="card-body">
  </div>
  <div class="card-footer">
    <%= link_to "Edit", edit_checkin_field_path(@checkin_field), class: "btn btn-warning" %>
    <%= link_to "Delete", @checkin_field, class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: checkin_answers_delete_confirm(@checkin_field.answer_count) } %>
  </div>
</div>
