<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

<div class="form-inputs">
  <%= f.input :parent_label %>
  <%= f.input :child_label %>
  <%= f.input :permission, as: :select, collection: RelationshipType.permissions.keys, label_method: :titleize, include_blank: false %>
  <%= f.input :guardianship, as: :select, collection: RelationshipType::GUARDIANSHIP_LABELS.invert, include_blank: false,
        hint: safe_join([ "Guardians can see and edit fields set to family or guardian levels on the child-side person's profile.",
          ("This type already has links, so its guardianship can be reduced but not increased. To give guardianship, create a new type and link people to it." if f.object.guardianship_locked?) ].compact, " ") %>
</div>
