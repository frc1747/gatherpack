<% breadcrumb :inventory_item_source, @item_source %>
<% content_for :title, "Where to buy #{@item.name}" %>

<div class="card">
  <div class="card-header"><h1>Where to buy <%= @item.name %></h1></div>
  <div class="card-body"><%= render "form", item_source: @item_source %></div>
  <div class="card-footer">
    <%= link_to "Remove", inventory_item_source_path(@item, @item_source), class: "btn btn-danger",
      data: { turbo_method: :delete, turbo_confirm: "Remove #{@item_source.vendor_name}?" } %>
  </div>
</div>
