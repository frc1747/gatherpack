<% breadcrumb :inventory_item_readings, @item %>
<% content_for :title, "Readings: #{@item.name}" %>

<div class="row"><div class="col-lg-8 col-xl-6">
  <h1 class="h3">Readings for <%= @item.name %></h1>
  <p class="text-body-secondary">What a check can record for each unit, such as hours of use or a measured voltage. None are required. Clear a name to remove a reading; past checks keep their values.</p>
  <% if @item.errors.any? %>
    <div class="alert alert-danger"><%= @item.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= form_with model: @item, url: inventory_item_readings_path(@item), method: :patch, scope: :item do |form| %>
    <% rows = Array(@item.reading_fields) + Array.new(Inventory::ItemReadingsController::BLANK_ROWS) { {} } %>
    <div class="row g-2 mb-1 small fw-semibold">
      <div class="col-8">Name</div>
      <div class="col-4">Unit</div>
    </div>
    <% rows.each_with_index do |field, index| %>
      <div class="row g-2 mb-2">
        <div class="col-8">
          <%= text_field_tag "item[reading_fields][][name]", field["name"], class: "form-control", id: "reading_name_#{index}",
                aria: { label: "Reading #{index + 1} name" } %>
        </div>
        <div class="col-4">
          <%= text_field_tag "item[reading_fields][][unit]", field["unit"], class: "form-control", id: "reading_unit_#{index}",
                aria: { label: "Reading #{index + 1} unit" }, placeholder: "h, V" %>
        </div>
      </div>
    <% end %>
    <%= form.submit "Save readings", class: "btn btn-primary" %>
    <%= link_to "Cancel", inventory_item_path(@item), class: "btn btn-warning" %>
  <% end %>
</div></div>
