<% pages = Inventory.manager_pages(current_person) %>
<% if pages.any? %>
  <nav class="d-flex flex-wrap gap-2 my-3 inventory-no-print" aria-label="Inventory pages">
    <% pages.each do |label, route, icon| %>
      <%= link_to send(route), class: "btn btn-secondary" do %>
        <i class="fa-solid fa-<%= icon %>"></i> <%= label %>
      <% end %>
    <% end %>
    <% if current_user&.admin %>
      <%= link_to inventory_setup_path, class: "btn btn-secondary" do %>
        <i class="fa-solid fa-gear"></i> Setup
      <% end %>
    <% end %>
  </nav>
<% end %>
