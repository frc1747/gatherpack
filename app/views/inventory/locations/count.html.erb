<% breadcrumb :inventory_count, @location %>
<% content_for :title, "Count #{@location.name}" %>
<% inventory_stylesheet %>

<div class="inventory-phone inventory-has-bar">
  <h1 class="h3">Count <%= @location.name %></h1>
  <%= form_with url: count_inventory_location_path(@location), method: :post, id: "count-form",
    data: { controller: "inventory-count", action: "keydown.enter->inventory-count#enter" } do |f| %>
    <p class="text-body-secondary">Type what you see for each item. Leave one blank to skip it.
      <span class="fw-semibold" data-inventory-count-target="progress"></span></p>
    <% @levels.each do |level| %>
      <section class="card mb-3" data-inventory-count-target="step" data-name="<%= level.item.name %>" data-current="<%= level.quantity %>">
        <div class="card-body">
          <h2 class="h4"><%= level.item.name %></h2>
          <% if level.item.manufacturer_part_number.present? %>
            <p class="text-body-secondary mb-2"><%= level.item.manufacturer_part_number %></p>
          <% end %>
          <%= label_tag "counts_#{level.item.id}", "How many do you see?", class: "form-label" %>
          <div class="inventory-stepper" data-controller="inventory-stepper">
            <button type="button" class="btn btn-secondary" data-action="inventory-stepper#decrement" aria-label="One fewer">−</button>
            <%= number_field_tag "counts[#{level.item.id}]", nil, id: "counts_#{level.item.id}", min: 0, step: 1, inputmode: "numeric",
              pattern: "[0-9]*", class: "form-control", data: { inventory_stepper_target: "input" } %>
            <button type="button" class="btn btn-secondary" data-action="inventory-stepper#increment" aria-label="One more">+</button>
          </div>
          <div class="form-text"><%= level.item.unit %></div>
        </div>
      </section>
    <% end %>

    <section class="card mb-3" data-inventory-count-target="summary">
      <div class="card-body">
        <h2 class="h4">Differences</h2>
        <ul class="list-group" data-inventory-count-target="differences"></ul>
      </div>
    </section>

    <div class="inventory-bar">
      <button type="button" class="btn btn-secondary btn-lg" data-inventory-count-target="back" data-action="inventory-count#back">Back</button>
      <button type="button" class="btn btn-primary btn-lg" data-inventory-count-target="next" data-action="inventory-count#next" hidden>Next</button>
      <%= f.submit "Save counts", class: "btn btn-primary btn-lg", data: { inventory_count_target: "save" } %>
    </div>
  <% end %>
</div>
