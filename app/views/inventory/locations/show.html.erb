<% breadcrumb :inventory_location, @location %>
<% content_for :title, @location.name %>
<% inventory_stylesheet %>

<div class="inventory-phone <%= "inventory-has-bar" if @countable %>">
  <%= render "inventory/shared/undo_toast" %>
  <div class="card mb-3">
    <div class="card-header">
      <h1 class="h3 mb-1">
        <%= @location.name %>
        <% if @location.code.present? %><span class="badge text-bg-light border font-monospace"><%= @location.code %></span><% end %>
      </h1>
      <div class="small text-body-secondary"><%= @location.full_name %></div>
      <% if @levels.any? { |level| level.quantity.negative? } %><span class="badge text-bg-secondary">Needs a count</span><% end %>
      <% unless @location.active? %><span class="badge text-bg-light border">Inactive</span><% end %>
    </div>
    <% if @location.note.present? || (counted = @location.last_counted_at) %>
      <div class="card-body">
        <% if @location.note.present? %><p class="mb-1"><%= @location.note %></p><% end %>
        <% if counted %><p class="mb-0 text-body-secondary">Last counted <%= time_ago_in_words(counted) %> ago</p><% end %>
      </div>
    <% end %>
    <% if policy(@location).edit? %>
      <div class="card-footer d-flex flex-wrap gap-2 inventory-no-print">
        <%= link_to "Edit", edit_inventory_location_path(@location), class: "btn btn-warning" %>
        <%= link_to "Add a place inside", new_inventory_location_path(parent_id: @location.id), class: "btn btn-secondary" unless @location.machine? %>
        <%= link_to "Add an item here", new_inventory_item_path(location_id: @location.id), class: "btn btn-secondary" if policy(Item).new? && @location.storage? %>
        <%= link_to "Label", inventory_labels_path(places: [ @location.id ]), class: "btn btn-secondary" if policy(@location).labels? %>
        <%= link_to "Delete", inventory_location_path(@location), class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: "Delete #{@location.name}?" } if policy(@location).destroy? %>
      </div>
    <% end %>
  </div>

  <% if @location.machine? && Inventory.machines? %>
    <p>This is <%= Inventory.machine_word(article: true) %>: parts on it are tracked units. <%= link_to "Open its page", inventory_machine_path(@location) %>.</p>
  <% elsif @location.machine? %>
    <% units = policy_scope(ItemUnit).active.where(location: @location).includes(:item).order(:code) %>
    <h2 class="h4">Parts here</h2>
    <% if units.empty? %>
      <p class="text-body-secondary">Nothing is kept here.</p>
    <% else %>
      <ul class="list-group mb-3" id="units_here">
        <% units.each do |unit| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= link_to unit.identifier_name, inventory_unit_path(unit) %> <span class="text-body-secondary small"><%= unit.item.name %></span></span>
            <%= unit_condition_badge(unit) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <% if @children.any? %>
    <h2 class="h4">Places inside</h2>
    <div class="list-group mb-3">
      <% @children.each do |child| %>
        <%= link_to inventory_location_path(child), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          <span><i class="fa-solid fa-<%= child.identifier_icon %> text-body-secondary"></i> <%= child.name %></span>
          <% if child.code.present? %><span class="badge text-bg-light border font-monospace"><%= child.code %></span><% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% unless @location.machine? %>
    <h2 class="h4">What's here</h2>
    <% if @levels.empty? %>
      <p class="text-body-secondary">Nothing is kept here.</p>
    <% else %>
      <ul class="list-group mb-3" id="place-items">
        <% @levels.each do |level| %>
          <% item = level.item %>
          <li class="list-group-item" id="<%= dom_id(item, :here) %>">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <%= link_to item.name, inventory_item_path(item), class: "fw-semibold" %>
                <div><%= inventory_stock_badges(item, total: @totals[item.id]) %></div>
              </div>
              <% if level.quantity.negative? %>
                <span class="badge text-bg-secondary">Needs a count</span>
              <% else %>
                <strong class="fs-5"><%= inventory_quantity(level.quantity, item) %></strong>
              <% end %>
            </div>
            <div class="d-flex gap-2 mt-2">
              <% if inventory_may_record?("used", item, @location) && !level.new_record? %>
                <%= link_to "Used", new_inventory_movement_path(kind: "used", item_id: item.id, location_id: @location.id, return_to: request.path), class: "btn btn-primary flex-fill" %>
              <% end %>
              <% if inventory_may_record?("counted", item, @location) %>
                <%= link_to(level.quantity.negative? ? "Count now" : "Count", new_inventory_movement_path(kind: "counted", item_id: item.id, location_id: @location.id, return_to: request.path),
                  class: "btn #{level.quantity.negative? ? "btn-warning" : "btn-secondary"} flex-fill") %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= render "inventory/shared/manager_links" %>

  <% if @countable %>
    <div class="inventory-bar">
      <%= link_to "Count this place", count_inventory_location_path(@location), class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>
</div>
