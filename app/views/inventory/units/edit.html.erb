<% breadcrumb :inventory_unit_action, @unit, "Edit" %>
<% content_for :title, "Edit #{@unit.identifier_name}" %>

<div class="row"><div class="col-lg-8 col-xl-6">
  <h1 class="h3">Edit <%= @unit.identifier_name %></h1>
  <%= simple_form_for @unit, url: inventory_unit_path(@unit) do |f| %>
    <%= f.error_notification %>
    <%= f.input :code, hint: "The text on its label, unique in the team: A-07", input_html: { autocapitalize: "characters" } %>
    <%= f.input :serial_number %>
    <%= f.input :name, hint: "Optional: Left side" %>
    <%= f.input :in_service_on, as: :date, html5: true, label: "In use since" %>
    <%= f.input :photo, as: :file, input_html: { accept: "image/*" } %>
    <div class="d-flex flex-wrap gap-2 gp-form-actions">
      <%= link_to "Cancel", inventory_unit_path(@unit), class: "btn btn-lg btn-secondary" %>
      <%= f.button :submit, "Save", class: "btn-primary btn-lg" %>
    </div>
  <% end %>
</div></div>
