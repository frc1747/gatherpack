<%# The units section of a tracked item's page (inventory spec §3.15),
    registered with Inventory.extensions.register_item_panel. Units by
    place: available, inside other parts kept in storage, on each machine,
    in repair, retired. Managers turn
    tracking on and off and edit the readings a check asks for. Locals:
    item:, viewer:. %>
<% item_policy = ItemPolicy.new(viewer.user, item) %>
<section class="card mb-3" id="item_units">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="h5 mb-0"><%= item.tracked? ? "Units" : "Tracking" %></h2>
    <% if item.tracked? && ItemUnitPolicy.new(viewer.user, ItemUnit.new(item: item)).create? %>
      <%= link_to icon_text("plus", "Add units"), new_inventory_unit_path(item_id: item.id), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
  <div class="card-body">
    <% if item.tracked? %>
      <% units = ItemUnitPolicy::Scope.new(viewer.user, item.item_units).resolve.includes(:location, :installed_in).order(:code).to_a %>
      <% retired, current = units.partition(&:condition_retired?) %>
      <% repair, working = current.partition(&:flagged?) %>
      <% on_machines, stored = working.partition(&:on_machine?) %>
      <% inside, spare = stored.partition(&:installed_in_id?) %>
      <% groups = [] %>
      <% groups << [ "Available", spare.group_by(&:location) ] if spare.any? %>
      <% groups << [ "Inside other parts", inside.group_by(&:location) ] if inside.any? %>
      <% on_machines.group_by(&:location).sort_by { |machine, _| machine.name }.each do |machine, list| %>
        <% groups << [ "On #{machine.name}", { machine => list } ] %>
      <% end %>
      <% groups << [ "In repair", repair.group_by(&:location) ] if repair.any? %>
      <% groups << [ "Retired", retired.group_by(&:location) ] if retired.any? %>
      <% if groups.empty? %>
        <p class="text-body-secondary mb-0">No units yet.</p>
      <% end %>
      <% names = inventory_full_names(units.map(&:location).uniq) %>
      <% groups.each do |heading, by_place| %>
        <h3 class="h6 mt-2"><%= heading %> <span class="badge text-bg-secondary"><%= by_place.values.sum(&:size) %></span></h3>
        <% by_place.each do |place, list| %>
          <% unless place.machine? %><div class="small text-body-secondary"><%= names[place.id] %></div><% end %>
          <ul class="list-unstyled ms-2 mb-2">
            <% list.each do |unit| %>
              <li>
                <%= link_to unit.identifier_name, inventory_unit_path(unit) %>
                <%= unit_condition_badge(unit) unless unit.condition_retired? %>
                <%= tag.span("in #{unit.installed_in.identifier_name}", class: "small text-body-secondary") if unit.installed_in %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <% fields = Array(item.reading_fields) %>
      <div class="mt-3 small">
        <strong>Readings a check asks for:</strong>
        <%= fields.any? ? fields.map { |field| reading_heading(field) }.to_sentence : "none" %>
        <% if item_policy.update? %>
          · <%= link_to "Edit readings", edit_inventory_item_readings_path(item) %>
        <% end %>
      </div>
      <% if item_policy.stop_tracking? %>
        <%= button_to "Stop tracking each piece", inventory_item_tracking_path(item), method: :delete,
              class: "btn btn-sm btn-secondary mt-3", form: { data: { turbo_confirm: "Count #{item.name} as stock again?" } } %>
      <% end %>
    <% elsif item_policy.start_tracking? %>
      <% count = item.stock_levels.where("quantity > 0").sum(:quantity) %>
      <p class="mb-2">Track each piece when it's reused and worth following on its own. Each gets its own label, condition and history.</p>
      <%= button_to "Track each piece", inventory_item_tracking_path(item), class: "btn btn-primary",
            form: { data: { turbo_confirm: count.positive? ? "This turns the #{count} in stock into #{pluralize(count, "unit")}, with codes to fill in later. Go ahead?" : "Track each piece of #{item.name}?" } } %>
    <% end %>
  </div>
</section>
