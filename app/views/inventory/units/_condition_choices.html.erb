<%# Big radio buttons for the conditions an action offers (UnitCondition
    rows, from the part conditions list), with a link to that list for
    those who manage it. Locals: conditions, selected (a UnitCondition or
    nil), style (btn-outline-secondary or btn-outline-danger), legend. %>
<% list = defined?(GatherPack::ManagedLists) && GatherPack::ManagedLists.find(:unit_conditions) %>
<fieldset class="mb-3">
  <legend class="form-label fs-6"><%= legend %></legend>
  <div class="d-grid gap-2">
    <% conditions.each do |condition| %>
      <div>
        <%= radio_button_tag :condition, condition.id, condition == selected, id: "condition_#{condition.id}", class: "btn-check", autocomplete: "off" %>
        <%= label_tag "condition_#{condition.id}", condition.retired? ? "#{condition.name} (retired)" : condition.name,
              class: "btn btn-lg #{style} w-100 text-start" %>
      </div>
    <% end %>
  </div>
  <% if list && list.allowed?(current_user) %>
    <div class="form-text"><%= link_to "Manage #{list.plural_label.downcase}", managed_list_path(list.key) %></div>
  <% end %>
</fieldset>
