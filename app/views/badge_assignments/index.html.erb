<% breadcrumb :badge_assignments, @badge %>

<div class="card mb-3">
  <div class="card-header">
    <h1><%= as_badge @badge %> <%= @badge.name %></h1>
  </div>
</div>

<div class="row g-3">
  <% if @can_assign %>
    <div class="col-12 col-lg-6">
      <%= render layout: "shared/add_panel", locals: {
            title: "Add people",
            url: candidates_badge_badge_assignments_path(@badge),
            placeholder: @badge.team ? "Search members of #{@badge.team.name}…" : "Search people…"
          } do %>
        <%= render "candidates" %>
      <% end %>
    </div>
  <% end %>

  <div class="col-12 <%= "col-lg-6" if @can_assign %>">
    <div class="card">
      <div class="card-header">
        <h2 class="h5 mb-0">Current holders (<span id="badge_assignments_count"><%= @badge_assignments.total_count %></span>)</h2>
      </div>
      <div class="list-group list-group-flush" id="badge_assignments">
        <% @badge_assignments.each do |badge_assignment| %>
          <%= render "holder", badge_assignment: badge_assignment, can_remove: policy(badge_assignment).destroy? %>
        <% end %>
      </div>
      <% if @badge_assignments.empty? %>
        <p class="text-body-secondary p-3 mb-0" id="no_holders">No one has this badge yet.</p>
      <% end %>
      <div class="card-footer">
        <%= paginate @badge_assignments %>
      </div>
    </div>
  </div>
</div>
