<% breadcrumb :root %>
<% own = @activity.own? %>
<% title = own ? "Your activity" : "#{activity_first_name(@person)}'s activity" %>
<% content_for :title, title %>
<% content_for :head, stylesheet_link_tag("my_gatherpack_home", "my_gatherpack_activity") %>

<div class="mg-home mg-activity" data-activity-page>
  <header class="mg-home-header">
    <h1 class="mg-greeting"><%= title %></h1>
    <%= form_with url: activity_path, method: :get, class: "mg-activity-season", data: { turbo_action: "advance" } do |form| %>
      <% unless own %><%= hidden_field_tag :person, @person.neat_id %><% end %>
      <%= label_tag :season, "Season", class: "visually-hidden" %>
      <%= select_tag :season, options_for_select(@activity.seasons.map { |season| [ season.label, season.to_param ] }, @season.to_param), class: "form-select", onchange: "this.form.requestSubmit()" %>
      <%# Choosing a season shows it; the button is for when scripts are off. %>
      <%= form.submit "Show", name: nil, class: "btn btn-secondary d-none" %>
    <% end %>
  </header>

  <div class="row">
    <div class="col-12 col-lg-8">
      <%= render "my_gatherpack/activity/done", activity: @activity %>
    </div>
    <div class="col-12 col-lg-4">
      <%= render "my_gatherpack/activity/checklists", activity: @activity %>
      <%= render "my_gatherpack/activity/coming_up", activity: @activity %>
    </div>
  </div>
</div>
