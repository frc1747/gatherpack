<%# By kind of event: each row filters History below it. %>
<% rows = activity.kind_rows %>
<% if rows.any? %>
  <section class="mg-section" data-activity-block="kinds">
    <h2 class="mg-heading">By kind of event</h2>
    <div class="card mg-list">
      <% rows.each do |row| %>
        <% selected = row.key == kind %>
        <%= link_to activity_page_path(activity.person, season: (activity.season.to_param unless activity.season.current?), kind: (row.key unless selected), anchor: "history"),
              class: class_names("mg-row mg-activity-kind", "mg-activity-kind-selected" => selected), aria: { current: (selected ? "true" : nil) },
              data: { activity_kind: row.key } do %>
          <div class="mg-row-body">
            <div class="mg-row-title"><%= row.name %></div>
            <div class="mg-row-detail"><%= activity_kind_detail(row) %></div>
          </div>
          <% if (counts = activity_counts_toward(activity, row)) %>
            <div class="mg-activity-counts text-end" data-activity-counts><%= counts %></div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
