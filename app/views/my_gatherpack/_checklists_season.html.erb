<%# Your season: each checklist with unfinished items, with a progress bar. Renders nothing when there are none. %>
<% entries = my_gatherpack_season_entries %>
<% if entries.any? %>
  <section class="mg-section" data-home-section="checklists-season">
    <h2 class="mg-heading">Your season</h2>
    <div class="card mg-list">
      <% entries.each do |entry| %>
        <div class="mg-row d-block" id="<%= dom_id entry.checklist, "season_#{entry.subject.id}" %>">
          <div class="mg-row-title">
            <%= link_to entry.checklist.title, entry.ward ? person_checklists_path(entry.subject) : checklist_path(entry.checklist) %>
            <% if entry.ward %><span class="mg-row-ward">for <%= entry.ward %></span><% end %>
          </div>
          <div class="progress my-2" role="progressbar" aria-label="<%= entry.checklist.title %>" aria-valuenow="<%= entry.percent %>" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: <%= entry.percent %>%"></div>
          </div>
          <% entry.open_items.each do |item| %>
            <div class="mg-row-detail"><%= item.item.label %><%= count = my_gatherpack_season_count(item); count ? ": #{count}" : (item.summary.present? ? ": #{item.summary}" : "") %></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
