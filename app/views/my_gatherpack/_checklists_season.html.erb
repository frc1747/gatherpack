<%# My Season: checklist items that aren't to-dos, in words. Tapping a line shows its detail. Renders nothing when there are none. %>
<% season = my_gatherpack_season %>
<% if season.any? %>
  <% content_for :head, stylesheet_link_tag("my_gatherpack_checklists") %>
  <section class="mg-section" data-home-section="checklists-season">
    <h2 class="mg-heading">My Season</h2>
    <div class="card mg-list">
      <% if season.in_progress.empty? && my_gatherpack_rows(:todo).empty? %>
        <div class="mg-row mg-season-all-set">You're all set for now</div>
      <% end %>
      <% if season.in_progress.any? %>
        <div class="mg-season-group" data-season-group="in-progress">
          <h3 class="mg-season-label">In progress</h3>
          <%= render partial: "my_gatherpack/checklists_season_line", collection: season.in_progress, as: :line %>
        </div>
      <% end %>
      <% if season.done.any? %>
        <% done_id = "mg-season-done" %>
        <div class="mg-season-group" data-season-group="done">
          <button type="button" class="mg-season-done collapsed" data-bs-toggle="collapse" data-bs-target="#<%= done_id %>" aria-expanded="false" aria-controls="<%= done_id %>">
            <span class="mg-season-label">Done</span>
            <span class="mg-season-done-titles"><%= season.done.map { |line| line.entry.item.label }.uniq.join(", ") %></span>
            <span class="mg-season-chevron"><%= i("chevron-down") %></span>
          </button>
          <div class="collapse" id="<%= done_id %>">
            <%= render partial: "my_gatherpack/checklists_season_line", collection: season.done, as: :line %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
