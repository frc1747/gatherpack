<%# A sign-up in Coming up: the date, the place, and the sheet. A ward's row names the ward. %>
<div class="mg-row">
  <div class="mg-row-date">
    <span class="mg-row-weekday"><%= item.at.strftime("%a") %></span>
    <span class="mg-row-day"><%= item.at.day %></span>
  </div>
  <div class="mg-row-body">
    <div class="mg-row-title">
      <%= link_to item.title, item.path %>
      <% if item.ward %><span class="mg-row-ward">for <%= item.ward %></span><% end %>
    </div>
    <div class="mg-row-detail"><%= item.detail %></div>
  </div>
</div>
