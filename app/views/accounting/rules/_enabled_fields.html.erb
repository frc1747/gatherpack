<%# locals: (f:, rule:) -%>
<fieldset class="mb-3">
  <legend class="form-label fs-6">Showing results</legend>
  <div class="form-check">
    <%= f.radio_button :enabled, true, class: "form-check-input" %>
    <%= f.label :enabled, "Yes: worked out every night and after each sync, and shown to the people it lets see them", value: true, class: "form-check-label" %>
  </div>
  <div class="form-check">
    <%= f.radio_button :enabled, false, class: "form-check-input" %>
    <%= f.label :enabled, "No, turned off: only admins see it, and its results aren't worked out until it's turned on", value: false, class: "form-check-label" %>
  </div>
</fieldset>
