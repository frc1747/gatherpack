<% breadcrumb :accounting_rule, @rule %>
<% admin = current_user.admin %>
<% source = @rule.gateway %>
<% filter_params = { unapplied: (params[:unapplied] if admin) }.compact %>

<div class="card mb-3">
  <%= render "shared/page_header", title: @rule.name, summary: @rule.description,
        state: state_line([ "From #{source.name}", @rule.kind_name, ("Turned off" unless @rule.enabled?) ].compact.join(" · "),
          link_text: ("Change" if policy(@rule).edit?), link_path: (edit_accounting_rule_path(@rule, tab: "enabled") if policy(@rule).edit?)) %>
  <div class="card-body">
    <p class="mb-1"><%= render "accounting/rules/counts", summary: @summary %></p>
    <p class="mb-1"><%= render "accounting/rules/totals", summary: @summary %></p>
    <% if admin && @rule.balance? && (unapplied = @summary.unapplied_credit_cents).positive? %>
      <p class="mb-1">Unapplied credit <%= accounting_cents(unapplied) %></p>
    <% end %>
    <% if admin && @rule.missing_roles.any? %>
      <p class="mb-1 text-danger">Not worked out: <%= source.name %> doesn't copy <%= @rule.missing_roles.map { |role| accounting_role_name(role).downcase.pluralize }.to_sentence %>.</p>
    <% end %>
  </div>
  <%= render "shared/action_row", actions: [
        screen_action("Edit", edit_accounting_rule_path(@rule), style: :warning, visible: policy(@rule).edit?),
        screen_action("Evaluate now", evaluate_accounting_rule_path(@rule), style: :primary, method: :post, visible: policy(@rule).evaluate?),
        screen_action("Duplicate", duplicate_accounting_rule_path(@rule), method: :post, more: true, visible: policy(@rule).duplicate?),
        screen_action("Delete", accounting_rule_path(@rule), method: :delete, destructive: true, visible: policy(@rule).destroy?,
          confirm: "Delete #{@rule.name} and everyone's results for it?")
      ] %>
</div>

<% statuses = [ { label: "All", value: nil } ] + @summary.counts.map { |value, label, count| { label: label, count: count, value: value } } %>
<% more = capture do %>
  <div class="form-check">
    <%= check_box_tag :unapplied, "1", params[:unapplied] == "1", class: "form-check-input" %>
    <%= label_tag :unapplied, "Only people with unapplied credit", class: "form-check-label" %>
  </div>
<% end if admin && @rule.balance? %>

<div <%= tag.attributes(class: "card", data: column_chooser_data("accounting-rule")) %>>
  <div class="card-body">
    <%= render "shared/filter_bar", url: accounting_rule_path(@rule), teams: @teams, team: @team, statuses: statuses, status: @value,
          params: filter_params, hidden: filter_params.except(:unapplied), more: more, open: params[:unapplied] == "1",
          table_actions: [
            screen_action("Print", nil, style: :dark, data: { controller: "print", action: "print#print" }),
            screen_action("Download CSV", export_accounting_rule_path(@rule, format: :csv, status: @value, team_id: @team&.id, **filter_params))
          ] %>
    <% columns = [ [ "Team", ->(result) { result.person.teams.map(&:name).sort.join(", ") } ] ] %>
    <% if @amount_ids.any? %>
      <% columns << [ "Amount", ->(result) { accounting_result_amount(result) if @amount_ids.include?(result.person_id) } ] %>
    <% end %>
    <% if @rule.balance? %>
      <% columns << [ "Next", ->(result) { accounting_milestone_line(result, amounts: @amount_ids.include?(result.person_id)) } ] %>
    <% end %>
    <% columns << [ "Changed on", ->(result) { result.changed_at && l(result.changed_at.to_date, format: :short) } ] %>
    <% if admin && @rule.balance? %>
      <% columns << [ "Unapplied credit", ->(result) { accounting_cents(result.unapplied_credit_cents) if result.unapplied_credit_cents.positive? } ] %>
    <% end %>
    <% if @customer_urls %>
      <% columns << [ "", ->(result) { (url = @customer_urls[result.person_id]) && link_to("Open in #{source.source_name}", url, target: "_blank", rel: "noopener") }, { data: { column_chooser_label: "Open in #{source.source_name}" } } ] %>
    <% end %>
    <%= render "shared/people_table", rows: @rows, columns: columns, empty: "Nobody here.",
          status: ->(result) { accounting_value_badge(@rule, result.value) } %>
  </div>
</div>
