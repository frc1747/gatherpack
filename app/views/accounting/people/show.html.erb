<%= render "people/show_shared" %>
<% admin = current_user.admin %>

<div class="card mb-3">
  <div class="card-header">
    <h1><%= @person.identifier_name %>: Account</h1>
  </div>
  <% if @results.empty? %>
    <div class="card-body"><%= render "shared/empty_state", text: "Nothing to show yet." %></div>
  <% else %>
    <ul class="list-group list-group-flush">
      <% @results.each do |result| %>
        <% rule = result.rule %>
        <% amounts = @amounts[result.id] %>
        <li class="list-group-item" id="<%= dom_id result %>">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div>
              <strong><%= admin ? link_to(rule.name, accounting_rule_path(rule)) : rule.name %></strong>
              <%= accounting_value_badge(rule, result.value) %>
              <% unless rule.enabled? %><span class="badge text-bg-secondary">Turned off</span><% end %>
              <% if rule.description.present? %><div class="text-muted small"><%= rule.description %></div><% end %>
              <% if rule.balance? && (line = accounting_milestone_line(result, amounts: amounts)) %>
                <div><%= line %></div>
              <% end %>
              <% if amounts %>
                <% if rule.balance? && result.value != "not_invoiced" %>
                  <div>Balance remaining <strong><%= accounting_cents(result.amount_cents) %></strong> of <%= accounting_cents(result.detail(:charged_cents)) %></div>
                <% elsif rule.kind == "amount" %>
                  <div><strong><%= accounting_cents(result.amount_cents) %></strong></div>
                <% elsif rule.kind == "count" %>
                  <div><strong><%= result.detail(:count).to_i %></strong></div>
                <% end %>
                <% if result.charges.any? %>
                  <ul class="small mb-0">
                    <% result.charges.each do |charge| %>
                      <li>
                        <%= charge["label"] %>: <%= accounting_cents(charge["balance_cents"]) %> left of <%= accounting_cents(charge["total_cents"]) %>
                        <% if charge["due_on"] %>, due <%= accounting_date(charge["due_on"]) %><% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
                <% if rule.balance? && !rule.count_unapplied_credit? && result.unapplied_credit_cents.positive? %>
                  <div class="small">A payment of <%= accounting_cents(result.unapplied_credit_cents) %> is waiting to be applied.</div>
                <% end %>
              <% end %>
              <% if admin && result.error? %><div class="small text-danger"><%= result.detail(:error) %></div><% end %>
              <div class="text-muted small">As of <%= l(result.evaluated_at, format: :short) %></div>
            </div>
            <% if amounts && rule.pay_links? && result.amount_cents.to_i.positive? %>
              <% result.charges.select { |charge| charge["pay_url"].present? && charge["balance_cents"].to_i.positive? }.each do |charge| %>
                <%= link_to "Pay online", charge["pay_url"], class: "btn btn-primary", target: "_blank", rel: "noopener", title: charge["label"] %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= render "shared/action_row", actions: [
        screen_action("Statement", person_accounting_statement_path(@person), visible: @statement)
      ] %>
</div>

<% if admin %>
  <div class="card">
    <div class="card-header"><h2 class="h5 mb-0">Linked customers</h2></div>
    <% if @customer_links.any? %>
      <ul class="list-group list-group-flush">
        <% @customer_links.each do |link| %>
          <% customer = link.customer %>
          <li class="list-group-item d-flex flex-wrap justify-content-between gap-2">
            <span><%= customer&.identifier_name || link.customer_external_id %> <span class="text-muted">in <%= link.gateway.name %></span></span>
            <%= link_to "Manage links", customer ? accounting_connection_customer_path(link.gateway, customer) : accounting_connection_customers_path(link.gateway),
                  class: "btn btn-sm btn-outline-secondary" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="card-body"><%= render "shared/empty_state", text: "Not linked to any customer." %></div>
    <% end %>
  </div>
<% end %>
