<%= f.input :email %>

<% if @user.provider %>
  <div class="alert alert-warning">
    This person signs in with <%= @user.provider %>
  </div>
<% else %>
  <%= f.input :password %>
  <%= f.input :password_confirmation %>
<% end %>
<% if @user.persisted? && @user == current_user %>
  <%= f.input :old_password, label: "Current password", hint: "Needed to change your own email or password." %>
<% end %>

<% if current_user.admin? %>
  <p><strong>Sitewide Privileges</strong></p>
  <%= f.input :admin %>
  <%= f.input :kiosk, label: "Kiosk account", hint: "For a shared device that runs the time kiosk. It can only use the time kiosk." %>
  <% if current_user.architect? %>
    <%= f.input :architect %>
  <% end %>
<% end %>
