<%# locals: (url:, teams: [], team: nil, statuses: [], status: controller.params[:status].presence, params: {}, hidden: nil, more: nil, open: false, table_actions: [], table_actions_html: nil, all_teams_label: "All teams", form_id: nil, fields: nil, auto_submit: false) -%>
<%# Filters above a table. teams: the teams to choose from (no team filter
    for one or none); statuses: { label:, count:, value: } pills, the first
    usually { label: "All", value: nil }, and a pill with no one in it is
    left out unless it's the current one; params: the page's other options,
    kept by the pills and the Show button; hidden: what the Show button keeps
    instead, when fields under More choices already carry some of the
    options (tick boxes would otherwise add back what was unticked); more:
    rarely used fields (HTML, e.g. from capture), inside "More choices",
    which starts open when open: is true (pass it when one of them is set);
    table_actions: actions on what the table shows (Print, Download CSV), at
    the right; table_actions_html: controls there that aren't links (a Print
    button, a layout choice; give inputs form: form_id to send them with
    Show); all_teams_label: the team select's blank choice; fields: more
    fields (HTML, e.g. a season select), always shown, sent with Show;
    auto_submit: true shows a change to fields or the team at once and hides
    Show (Show stays without JavaScript, and while More choices is there).
    A change under More choices always applies at once; More choices also
    has its own Show at the bottom. The table actions start with an empty
    column-chooser slot, which a Columns chooser around the bar fills. %>
<% pills = statuses.reject { |pill| pill[:value].present? && pill[:count]&.zero? && pill[:value].to_s != status.to_s } %>
<% team_filter = teams.size > 1 %>
<% show_form = team_filter || more.present? || fields.present? %>
<% path, query = url_for(url).split("?", 2) %>
<% kept = Rack::Utils.parse_nested_query(query).merge((hidden || params).to_h.stringify_keys).except("team_id", "status").compact_blank %>
<div class="d-flex flex-wrap align-items-start gap-2 mb-3 screen-filter-bar">
  <div class="flex-grow-1">
    <% if show_form %>
      <%= form_with url: path, method: :get, id: form_id, class: "d-flex flex-wrap align-items-end gap-2",
            data: (auto_submit || more.present? ? { controller: "filter-bar", action: "change->filter-bar#submit", filter_bar_auto_value: (true if auto_submit) }.compact : {}) do %>
        <% kept.each do |name, value| %>
          <% Array(value).each do |item| %><%= hidden_field_tag(value.is_a?(Array) ? "#{name}[]" : name, item, id: nil) %><% end %>
        <% end %>
        <%= hidden_field_tag :status, status, id: nil if status.present? %>
        <%= fields %>
        <% if team_filter %>
          <div>
            <%= label_tag :team_id, "Team", class: "form-label" %>
            <%= select_tag :team_id, options_from_collection_for_select(teams, :id, :name, team&.id), include_blank: all_teams_label, class: "form-select" %>
          </div>
        <% end %>
        <%= submit_tag "Show", class: "btn btn-secondary", name: nil, data: (auto_submit ? { filter_bar_target: "show" } : {}) %>
        <% if more.present? %>
          <details class="w-100 screen-filter-more" <%= "open" if open %>>
            <summary>More choices</summary>
            <div class="mt-2"><%= more %></div>
            <%= submit_tag "Show", class: "btn btn-secondary btn-sm mt-2", name: nil %>
          </details>
        <% end %>
      <% end %>
    <% end %>
    <% if pills.any? %>
      <div class="d-flex flex-wrap gap-2 screen-filter-pills <%= "mt-2" if show_form %>">
        <% pills.each do |pill| %>
          <% active = pill[:value].to_s == status.to_s %>
          <%= link_to [ pill[:label], ("(#{pill[:count]})" if pill[:count]) ].compact.join(" "),
                screen_filter_url(url, params, team_id: team&.id, status: pill[:value].presence),
                class: "btn btn-sm #{active ? "btn-secondary" : "btn-outline-secondary"}",
                aria: { current: ("true" if active) } %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% table_actions = table_actions.select(&:visible?) %>
  <% if table_actions.any? || table_actions_html.present? %>
    <div class="d-flex flex-wrap align-items-center gap-2 ms-auto screen-table-actions">
      <div style="display: contents" data-column-chooser-target="slot"></div>
      <%= table_actions_html %>
      <% table_actions.each do |action| %>
        <%= screen_action_button(action) %>
      <% end %>
    </div>
  <% else %>
    <div class="ms-auto" data-column-chooser-target="slot"></div>
  <% end %>
</div>
