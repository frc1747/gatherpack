<%# locals: (url:, teams: [], team: nil, statuses: [], status: params[:status].presence, more: nil, table_actions: []) -%>
<%# Filters above a table. teams: the teams to choose from (no team filter
    for one or none); statuses: { label:, count:, value: } pills, the first
    usually { label: "All", value: nil }, and a pill with no one in it is
    left out unless it's the current one; more: rarely used fields (HTML,
    e.g. from capture), inside "More choices"; table_actions: actions on what
    the table shows (Print, Download CSV), at the right. %>
<% pills = statuses.reject { |pill| pill[:value].present? && pill[:count]&.zero? && pill[:value].to_s != status.to_s } %>
<% team_filter = teams.size > 1 %>
<div class="d-flex flex-wrap align-items-start gap-2 mb-3 screen-filter-bar">
  <div class="flex-grow-1">
    <% if team_filter || more.present? %>
      <%= form_with url:, method: :get, class: "d-flex flex-wrap align-items-end gap-2" do %>
        <%= hidden_field_tag :status, status, id: nil if status.present? %>
        <% if team_filter %>
          <div>
            <%= label_tag :team_id, "Team", class: "form-label" %>
            <%= select_tag :team_id, options_from_collection_for_select(teams, :id, :name, team&.id), include_blank: "All teams", class: "form-select" %>
          </div>
        <% end %>
        <%= submit_tag "Filter", class: "btn btn-secondary", name: nil %>
        <% if more.present? %>
          <details class="w-100">
            <summary>More choices</summary>
            <div class="mt-2"><%= more %></div>
          </details>
        <% end %>
      <% end %>
    <% end %>
    <% if pills.any? %>
      <div class="d-flex flex-wrap gap-2 <%= "mt-2" if team_filter || more.present? %>">
        <% pills.each do |pill| %>
          <% active = pill[:value].to_s == status.to_s %>
          <% query = { team_id: team&.id, status: pill[:value].presence }.compact %>
          <%= link_to [ pill[:label], ("(#{pill[:count]})" if pill[:count]) ].compact.join(" "),
                query.any? ? "#{url}?#{query.to_query}" : url,
                class: "btn btn-sm #{active ? "btn-secondary" : "btn-outline-secondary"}",
                aria: { current: ("true" if active) } %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% table_actions = table_actions.select(&:visible?) %>
  <% if table_actions.any? %>
    <div class="d-flex flex-wrap gap-2 ms-auto">
      <% table_actions.each do |action| %>
        <%= screen_action_button(action) %>
      <% end %>
    </div>
  <% end %>
</div>
