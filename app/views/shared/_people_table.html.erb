<%# locals: (rows:, columns: [], empty: "Nobody here.", person: ->(row) { row.person }, link: ->(row) { person_path(person.call(row)) }, status: nil) -%>
<%# A table with one row per person: Person (linked), Status, then the caller's
    columns. columns: [header, ->(row) { cell }] pairs. status: ->(row) { badge },
    in the feature's words; leave it out for no Status column. link: where the
    name goes (the person's page unless given). %>
<% if rows.empty? %>
  <%= render "shared/empty_state", text: empty %>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Person</th>
          <% if status %><th>Status</th><% end %>
          <% columns.each do |header, _| %><th><%= header %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr id="<%= dom_id person.call(row) %>">
            <td><%= link_to person.call(row).identifier_name, link.call(row) %></td>
            <% if status %><td><%= status.call(row) %></td><% end %>
            <% columns.each do |_, cell| %><td><%= cell.call(row) %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
