<% breadcrumb @checklist %>
<% checklist_policy = policy(@checklist) %>

<div class="card" data-controller="checklist-report">
  <% starting = @organizer && @checklist.draft? %>
  <%= render "shared/page_header", title: @checklist.title,
        summary: "#{@checklist.team.name} · #{checklist_window_text(@checklist)}",
        state: state_line(checklist_state_text(@checklist), link_text: ("Start counting" if starting), link_path: (edit_checklist_path(@checklist, tab: "details") if starting)) %>
  <div class="card-body">
    <%= md(@checklist.description) if @checklist.description.present? %>
    <% if @checklist.ends_on %>
      <p class="mb-1">
        <% if @checklist.ends_on >= Date.current %>
          Counting until <%= l(@checklist.ends_on, format: :long) %>; these are today's numbers.
        <% else %>
          As of <%= l(@checklist.ends_on, format: :long) %>, when counting stopped.
          <% unless @checklist.archived? %>Results are frozen.<% if @organizer %> Recompute to apply corrections.<% end %><% end %>
        <% end %>
      </p>
    <% end %>
    <% if (change = @checklist.last_change_text(details: @full_view)) %>
      <p class="small text-body-secondary mb-1"><%= change %>.</p>
    <% end %>
    <% if @organizer && (problems = @checklist.problems).any? %>
      <div class="alert alert-warning mb-2">
        <p class="fw-semibold mb-1">Setup problems</p>
        <ul class="mb-2"><% problems.each do |problem| %><li><%= problem %></li><% end %></ul>
        <%= link_to "Fix them on the Edit page", edit_checklist_path(@checklist), class: "alert-link" %>
      </div>
    <% end %>

    <%= render "report", report: @report, checklist: @checklist, organizer: @organizer, as_of: @as_of %>
  </div>
  <%= render "shared/action_row", wrapper_class: "card-footer no-print", actions: [
        screen_action("Edit", edit_checklist_path(@checklist), style: :warning, visible: @organizer),
        screen_action("Take Snapshot", checklist_checklist_lists_path(@checklist), method: :post, visible: @organizer),
        screen_action("Recompute", refresh_checklist_path(@checklist), method: :post, more: true, visible: @organizer),
        screen_action("Copy", copy_checklist_path(@checklist), more: true, visible: checklist_policy.copy?),
        screen_action("Archive", archive_checklist_path(@checklist), method: :post, lifecycle: true, visible: checklist_policy.archive?,
          confirm: "Archive this checklist? It becomes read-only; results and snapshots are kept."),
        screen_action("Restore", restore_checklist_path(@checklist), method: :post, lifecycle: true, visible: checklist_policy.restore?,
          confirm: "Restore this checklist? It starts counting again."),
        screen_action("Delete", checklist_path(@checklist), method: :delete, destructive: true, visible: checklist_policy.destroy?,
          confirm: "Delete #{@checklist.title} and all its results?")
      ] %>
</div>

<% lists = checklist_policy.copy? ? @checklist.checklist_lists.order(recorded_at: :desc).to_a : [] %>
<% if lists.any? %>
  <div class="card mt-3 no-print" id="lists">
    <div class="card-header"><h2 class="h5 mb-0">Snapshots</h2></div>
    <div class="card-body">
      <ul class="list-unstyled mb-0">
        <% lists.each do |list| %>
          <li><%= link_to l(list.recorded_at, format: :long), checklist_checklist_list_path(@checklist, list) %><%= " — #{list.note}" if list.note.present? %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
