<% breadcrumb @checklist %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
      <h1 class="mb-0"><%= @checklist.title %></h1>
      <div class="text-body-secondary">
        <%= @checklist.team.name %> · <%= checklist_window_text(@checklist) %>
        <% unless @checklist.active? %><span class="badge text-bg-secondary"><%= @checklist.status.humanize %></span><% end %>
      </div>
    </div>
    <% if @organizer %>
      <div class="d-flex gap-2 flex-wrap no-print">
        <%= link_to "Edit", edit_checklist_path(@checklist), class: "btn btn-warning" %>
        <%= link_to "Copy", copy_checklist_path(@checklist), class: "btn btn-info" %>
        <%= button_to "Record this list", checklist_checklist_lists_path(@checklist), class: "btn btn-secondary", form_class: "d-inline" %>
        <%= button_to "Recompute", refresh_checklist_path(@checklist), class: "btn btn-outline-secondary", form_class: "d-inline" %>
      </div>
    <% end %>
  </div>
  <div class="card-body">
    <%= md(@checklist.description) if @checklist.description.present? %>
    <% if @checklist.cutoff_on %>
      <p class="mb-1">
        <% if @checklist.cutoff_on >= Date.current %>
          Counting up to <%= l(@checklist.cutoff_on, format: :long) %>; these are today's numbers.
        <% else %>
          As of <%= l(@checklist.cutoff_on, format: :long) %>, when counting stopped.
        <% end %>
      </p>
    <% end %>
    <% if @organizer && (change = @checklist.last_change) %>
      <p class="small text-body-secondary mb-1">Changed <%= l(change.created_at.to_date, format: :long) %>: <%= change.item_type.titleize.downcase.sub("checklist ", "") %> <%= change.event == "destroy" ? "removed" : "edited" %>.</p>
    <% end %>
    <% if @organizer && (problems = @checklist.problems).any? %>
      <div class="alert alert-warning mb-2">
        <p class="fw-semibold mb-1">Setup problems</p>
        <ul class="mb-0"><% problems.each do |problem| %><li><%= problem %></li><% end %></ul>
      </div>
    <% end %>
    <% if @organizer %>
      <%= form_with url: checklist_path(@checklist), method: :get, class: "d-flex gap-2 align-items-center no-print" do %>
        <%= label_tag :as_of, "As of", class: "form-label mb-0" %>
        <%= date_field_tag :as_of, @as_of, autocomplete: "off", class: "form-control form-control-sm w-auto" %>
        <%= submit_tag "Show", class: "btn btn-sm btn-outline-primary", name: nil %>
        <%= link_to "Today", checklist_path(@checklist), class: "btn btn-sm btn-link" if @as_of %>
      <% end %>
      <% if @as_of %><p class="small text-body-secondary mt-1 mb-0">Computed as of <%= l(@as_of, format: :long) %>; nothing is saved.</p><% end %>
    <% end %>
  </div>
</div>

<%= render "report", report: @report, checklist: @checklist, organizer: @organizer %>
<%= render "setup", checklist: @checklist if @organizer %>
