<%# One person's results on one checklist, unmet first, with what to do. %>
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><%= link_to checklist.title, checklist %></span>
    <%= checklist_status_badge(status.overall) %>
  </div>
  <ul class="list-group list-group-flush">
    <% status.explained.each do |entry| %>
      <li class="list-group-item">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div>
            <strong><%= entry.item.label %></strong>
            <% if entry.full? %>
              <div class="small"><%= entry.detail.presence || entry.summary %></div>
              <% if entry.excuse && entry.excuse["by"] %><div class="small text-body-secondary">Excused by <%= entry.excuse["by"] %>, <%= l(Date.iso8601(entry.excuse["at"]), format: :long) %></div><% end %>
              <% Array(entry.children).each do |child| %>
                <div class="small ms-3"><%= checklist_status_badge(child) %> <%= child.item.label %><%= ": #{child.summary}" if child.full? && child.summary.present? %></div>
              <% end %>
            <% end %>
          </div>
          <div class="text-end text-nowrap">
            <%= checklist_status_badge(entry) %>
            <div class="mt-1"><%= checklist_fix(checklist, entry, status.person_id) if entry.full? %></div>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>
