<ul class="list-group mb-2">
  <% items.each do |item| %>
    <li class="list-group-item">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <strong><%= item.label %></strong>
          <span class="badge text-bg-light"><%= item.kind_label %></span>
          <% unless item.counts? %><span class="badge text-bg-light">shown only</span><% end %>
          <div class="small text-body-secondary"><%= item.describe %></div>
        </div>
        <div class="text-nowrap">
          <%= link_to "Edit", edit_checklist_checklist_item_path(checklist, item), class: "btn btn-sm btn-outline-secondary" %>
          <%= button_to "Remove", checklist_checklist_item_path(checklist, item), method: :delete, class: "btn btn-sm btn-outline-danger", form_class: "d-inline",
            data: { turbo_confirm: "Remove #{item.label}?" } %>
        </div>
      </div>
      <% if item.container? %>
        <div class="border rounded p-2 mt-2 ms-3">
          <div class="small fw-semibold mb-1">Any one of these is enough</div>
          <%= render "checklists/item_list", checklist: checklist, items: item.children %>
          <%= render "checklists/add_item_menu", checklist: checklist, parent: item %>
        </div>
      <% end %>
    </li>
  <% end %>
</ul>
