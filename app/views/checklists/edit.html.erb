<% breadcrumb @checklist %>

<div class="card">
  <div class="card-header"><h1>Edit <%= @checklist.title_was %></h1></div>
  <div class="card-body"><%= render "form", checklist: @checklist, impact: @impact %></div>
</div>

<%# The parts below show what's saved, not the basics form's unsaved changes. %>
<%= render "setup", checklist: @checklist.changed? ? Checklist.find(@checklist.id) : @checklist %>
