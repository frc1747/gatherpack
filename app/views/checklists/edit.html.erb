<% breadcrumb @checklist %>
<% tab_path = ->(key) { key == "details" && params[:tab].blank? ? edit_checklist_path(@checklist) : edit_checklist_path(@checklist, tab: key) } %>
<% tabs = [ [ "Details", tab_path.("details") ], [ "Items (#{@checklist.checklist_items.size})", tab_path.("items") ],
            [ "Who it covers", tab_path.("covers") ], [ "Access", tab_path.("access") ] ] %>
<% tabs << [ "Reminders", tab_path.("reminders") ] if ChecklistReminderPolicy.new(current_user, @checklist).update? %>

<div class="card">
  <%= render "shared/page_header", title: "Edit #{@checklist.title_was}", tabs: %>
</div>

<% if @tab == "details" %>
  <div class="card mt-3"><%= render "form", checklist: @checklist, impact: @impact %></div>
<% else %>
  <%# A part's tab shows what's saved. %>
  <%= render "setup", checklist: @checklist, tab: @tab %>
<% end %>
