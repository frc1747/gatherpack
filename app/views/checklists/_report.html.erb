<%# locals: (report:, checklist:, organizer:, as_of: nil) -%>
<%# One row per visible person; sort by clicking a heading, filter by team and
    overall status (the filter bar), then by ticks, numbers and name in the page.
    Rows hold only what the viewer may see, so sorting and filtering can't reveal more. %>
<% order = %w[not_met pending met exempt] %>
<% counts = report.counts %>
<% statuses = if report.overall?
     [ { label: "All", count: report.in_team.size, value: nil } ] +
       order.map { |status| { label: checklist.word_for(status), count: counts[status].to_i, value: status } }
   else
     []
   end %>
<% as_of_field = capture do %>
  <% if organizer %>
    <div>
      <%= label_tag :as_of, "As of", class: "form-label" %>
      <%= date_field_tag :as_of, as_of, autocomplete: "off", class: "form-control" %>
    </div>
  <% end %>
<% end %>
<div class="no-print">
  <%= render "shared/filter_bar", url: checklist_path(checklist), teams: report.teams, team: report.team,
        all_teams_label: "Everyone", statuses: statuses, status: report.status,
        params: { as_of: as_of&.iso8601 }, fields: as_of_field.presence,
        table_actions: [ screen_action("Print", nil, style: :dark, data: { action: "checklist-report#print" }) ] %>
</div>
<% if as_of %>
  <p class="small text-body-secondary">
    <% if checklist.reads_stored_as_of?(as_of) %>
      The frozen results, as of <%= l(checklist.ends_on, format: :long) %>.
    <% else %>
      Computed as of <%= l(as_of, format: :long) %>; nothing is saved.
    <% end %>
    <%= link_to "Show today's", screen_filter_url(checklist_path(checklist), team_id: report.team&.id, status: report.status), class: "no-print" %>
  </p>
<% end %>

<% if report.statuses.empty? %>
  <%= render "shared/empty_state", text: "There's nobody here for you to see yet." %>
<% else %>
  <div class="row g-2 mb-2 no-print">
    <div class="col-md-4">
      <input type="search" autocomplete="off" class="form-control form-control-sm" placeholder="Filter by name" aria-label="Filter by name" data-checklist-report-target="name" data-action="input->checklist-report#filter">
    </div>
    <div class="col-md-8 small text-body-secondary">Tick values under a heading to show people with any of them; headings combine.</div>
  </div>
  <% measure_filters = report.measure_filters %>
  <%# Each column's results, across every section, for the filter lists: how many people have each status, and the words their badges show. %>
  <% column_entries = ->(item) { report.shown.filter_map { |row| item ? row.item(item.id) : row.overall }.group_by(&:status) } %>
  <% if measure_filters.any? %>
    <details class="mb-2 no-print small">
      <summary>Number filters</summary>
      <div class="row g-2 mt-1">
        <% measure_filters.each do |index, key, label| %>
          <div class="col-md-6 d-flex gap-2 align-items-center">
            <span class="flex-grow-1"><%= label %></span>
            <input type="number" autocomplete="off" class="form-control form-control-sm" style="width: 6em" placeholder="min" aria-label="<%= label %> at least"
              data-checklist-report-target="bound" data-column="<%= index %>" data-key="<%= key %>" data-bound="min" data-action="input->checklist-report#filter">
            <input type="number" autocomplete="off" class="form-control form-control-sm" style="width: 6em" placeholder="max" aria-label="<%= label %> at most"
              data-checklist-report-target="bound" data-column="<%= index %>" data-key="<%= key %>" data-bound="max" data-action="input->checklist-report#filter">
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

  <%# Columns after Person: each heading sorts on a click and filters by ticks. %>
  <% columns = [] %>
  <% if report.overall? %>
    <% columns << [ render("checklists/report_heading", label: "Overall", index: 1, entries: column_entries.(nil), order:),
         ->(row) { render "checklists/report_cell", entry: row.overall, order:, title: row.overall&.summary.presence } ] %>
  <% end %>
  <% report.columns.each_with_index do |item, offset| %>
    <% columns << [ render("checklists/report_heading", label: item.label, index: offset + report.first_item_index, entries: column_entries.(item), order:),
         ->(row) do
           entry = row.item(item.id)
           render "checklists/report_cell", entry:, order:, title: (entry.summary.presence if entry&.full?), item:, person_id: row.person_id, checklist:, report:
         end ] %>
  <% end %>

  <% report.sections.each do |section, rows| %>
    <% if section %><h2 class="h5 mt-3"><%= section %></h2><% end %>
    <%= render "shared/people_table", rows: rows, columns: columns, empty: "Nobody here.",
          person: ->(row) { report.people[row.person_id] }, link: ->(row) { person_checklists_path(report.people[row.person_id]) },
          table_class: "table table-sm align-top",
          wrapper: { data: { checklist_report_target: "table", action: "click->checklist-report#sort" } } %>
  <% end %>
<% end %>
