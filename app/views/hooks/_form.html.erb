<%= f.error_notification %>
<%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

<div class="row">
  <div class="col-md">
    <%= f.input :name %>
  </div>
  <div class="col-md">
    <%= f.input :event, as: :select, collection: Hook.catalog,
          hint: "Events starting with \"person_field\" or \"form\" receive restricted personal data. Only send it to systems approved to hold it." %>
  </div>
</div>

<%= f.input :code, wrapper_html: { class: "code-editor" }, input_html: { rows: 12 } %>
