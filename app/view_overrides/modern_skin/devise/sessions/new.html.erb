<%- if Settings[:local_auth] %>
  <div class="card">
    <div class="card-header">
      <h2>Sign in</h2>
    </div>
    <div class="card-body">
      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
        <%= f.input :email %>

        <%= f.input :password %>

        <% if devise_mapping.rememberable? %>
          <%= f.input :remember_me, as: :boolean %>
        <% end %>

        <% if devise_mapping.recoverable? %>
          <div class="mb-3">
            <%= link_to "Forgot your password?", new_password_path(resource_name) %>
          </div>
        <% end %>

        <div class="actions">
          <%= f.submit "Sign in", class: "btn btn-primary w-100" %>
        </div>
      <% end %>

      <%- if Settings[:local_signup] %>
        <p class="signin-signup mt-3 mb-0">
          New here? <%= link_to "Sign up", new_registration_path(resource_name) %>
        </p>
      <% end %>
    </div>
  </div>
<% end %>

<%= render partial: "devise/shared/omniauth" %>
