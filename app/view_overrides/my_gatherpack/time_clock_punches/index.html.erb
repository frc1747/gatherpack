<% breadcrumb :time_clock_punches %>
<% content_for :head, stylesheet_link_tag("my_gatherpack_hours") %>

<button class="btn btn-secondary w-100 mb-3 d-md-none mg-filter-toggle" type="button" data-bs-toggle="collapse" data-bs-target=".punch-filters" aria-expanded="false">
  <i class="fa-solid fa-filter"></i> Filter
</button>

<%= search_form_for @q, data: {"controller": "turbo_search", "turbo-frame": "results"} do |f| %>
<div class="card">
  <div class="card-header">
    <h1>Time Clock</h1>
  </div>
  <div class="card-body collapse d-md-block punch-filters">
    <div class="row">
      <div class="col-md">
        <% if params['q']&.has_key?('person_id_eq') %>
          <%= f.input :person_id_eq, label: "Person", as: :select, collection: policy_scope(Person), label_method: :identifier_name %>
        <% else %>
          <%= f.input :person_display_name_i_cont, label: "Person" %>
        <% end %>
      </div>
      <div class="col-md">
        <%= f.input :start_time_gteq, label: "Starting After", input_html: { type: "datetime-local" } %>
      </div>
      <div class="col-md">
        <%= f.input :end_time_lteq, label: "Ending Before", input_html: { type: "datetime-local" } %>
      </div>
      <div class="col-md">
        <%= f.input :time_clock_period_id_eq, label: "Periods", as: :select, collection: policy_scope(TimeClockPeriod) %>
      </div>
    </div>
  </div>
  <div class="card-footer d-flex flex-wrap align-items-start gap-2">
    <%= link_to "New Time Clock Punch", new_time_clock_punch_path, class: "btn btn-success" if policy(TimeClockPunch.new).new? %>
    <span class="collapse d-md-inline-block punch-filters">
      <%= f.submit "Search", class: "btn btn-primary", data: { action: "turbo_search#search" } %>
      <%= link_to "Clear Search", request.path, class: "btn btn-dark", data: { action: "turbo_search#clear" } %>
    </span>
    <%# The kiosk has its own layout, so it opens as a full page load. %>
    <%= render "shared/action_row", wrapper_class: "mg-hours-more", actions: [
          screen_action("Time Clock Periods", time_clock_periods_path, more: true),
          screen_action("Flag Review", flagged_time_clock_punches_path, more: true, visible: policy(TimeClockPunch).flagged?),
          screen_action("Time Clock Kiosk", time_kiosk_path, more: true, visible: manager?, data: { turbo: false })
        ] %>
  </div>
</div>
<% end %>

<%= turbo_frame_tag "results" do %>
  <div class="dropdown">
    <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      Sort By
    </button>
    <ul class="dropdown-menu">
      <li><%= sort_link @q, :start_time, "Start Time", class: "dropdown-item" %></li>
      <li><%= sort_link @q, :end_time, "End Time", class: "dropdown-item" %></li>
      <li><%= sort_link @q, :updated_at, "Last Updated", class: "dropdown-item" %></li>
    </ul>
  </div>

  <div class="row">
    <div class="col">
      <%= render "my_hours" %>
    </div>
  </div>
  <%= paginate @time_clock_punches %>
<% end %>
