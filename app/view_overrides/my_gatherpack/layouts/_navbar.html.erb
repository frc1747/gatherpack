<%# The sidebar carries the site's name and search at md and up. %>
<header class="navbar navbar-expand-lg bg-dark no-print<%= " d-md-none" if !kiosk_page? && (current_user.present? rescue false) %>">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">
      <% if Theme.instance.logo.attached? %>
        <%= image_tag Theme.instance.logo, alt: site_title %>
      <% else %>
        <%= image_tag "logo.svg" %>
      <% end %>
      &nbsp; <%= site_title %>
    </a>

      <% if !kiosk_page? && (current_user.present? rescue false) %>
      <div class="navbar-toggler" style="outline: none; border: none;">
        <button class="navbar-toggler text-white-50" type="button" data-bs-toggle="dropdown">
          <%= i "magnifying-glass" %>
        </button>
        <div class="dropdown-menu shadow-lg justify-content-center">
          <form class="d-flex" role="search" action="<%= search_path %>" style="width: 95%;">
            <input class="form-control me-1" type="search" name="q" placeholder="Search for anything..." aria-label="Search" autocomplete="off">
            <button class="btn btn-success" type="submit">
              <%= i "magnifying-glass" %>
            </button>
          </form>
        </div>

        <%# Below md the tab bar's More button opens the sidebar. %>
      </div>
    <% end %>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 d-flex align-items-center">
      </ul>
    <% if !kiosk_page? && (current_user.present? rescue false) %>
        <form class="d-flex" role="search" action="<%= search_path %>">
          <input class="form-control me-2" type="search" name="q" placeholder="Search for anything..." aria-label="Search" autocomplete="off">
          <button class="btn btn-success" type="submit">Search</button>
        </form>
      <% end %>
    </div>
  </div>
</header>
<% if !kiosk_page? && (current_user.present? rescue false) %>
  <%= render "layouts/phone_tabs" %>
<% end %>
